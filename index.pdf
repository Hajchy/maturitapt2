    topicSummaryAlternatives[12]=[
      ['Výsledek zkoušky závisí na odběru a přípravě vzorku i na podmínkách měření.','Destruktivní zkouška vzorek poruší nebo trvale změní; NDT zachová jeho použitelnost.','Tahové těleso se zatěžuje až do přetržení a zaznamenává se síla a prodloužení.','Re nebo Rp0,2 označuje mez kluzu, Rm maximální napětí, A tažnost a Z kontrakci.','Tvrdost vyjadřuje odpor proti místnímu vtlačení tvrdšího tělesa.','Brinell hodnotí průměr vtisku, Rockwell jeho hloubku a Vickers úhlopříčky.','Rázová zkouška Charpy hodnotí energii lomu vrubového tělesa.','Únava vzniká opakovaným zatěžováním; creep je časově závislá deformace při dlouhém zatížení.','Technologické zkoušky simulují ohyb, pěchování, tažení, svařování nebo obrábění.','Chemické a strukturní výsledky se doplňují s mechanickými zkouškami a řádným protokolem.'],
      ['Volba metody závisí na tom, jakou vlastnost nebo vadu potřebujeme ověřit.','Tahová zkouška popisuje pružnou a plastickou oblast a chování až do lomu.','Tažný materiál se před lomem prodlužuje a může vytvořit krček; křehký se deformuje málo.','Tlaková zkouška sleduje zkrácení a trhliny, přičemž štíhlý vzorek může vybočit.','Tvrdostní měření vyžaduje čistý povrch, oporu a správné rozmístění vtisků.','Převodní tabulky tvrdosti jsou přibližné a platí jen pro dané materiály a rozsahy.','Na rázový výsledek působí teplota, vrub, orientace vzorku a struktura.','Únavový lom může nastat pod mezí pevnosti z jednorázové tahové zkoušky.','Metalografický výbrus se připraví broušením, leštěním a případným naleptáním.','Protokol musí spojovat naměřenou hodnotu s metodou, podmínkami, jednotkami a kritériem shody.']
    ];
    topicSummaries[18]=[
      'Výrobní postup převádí požadavky výkresu na konkrétní, opakovatelný sled operací.',
      'Výrobní proces zahrnuje přeměnu materiálu i manipulaci, dopravu, kontrolu a skladování.',
      'Výroba se dělí na kusovou, malosériovou, sériovou a hromadnou podle množství a opakovatelnosti.',
      'Technolog postupuje od rozboru výkresu přes polotovar, pořadí operací a volbu stroje až ke kontrole.',
      'Hrubování obvykle předchází dokončování; základny se vytvářejí včas a tepelné zpracování může být mezi nimi.',
      'Technologická dokumentace zahrnuje výkres, postup, operační návod, průvodku, kontrolní plán a kusovník.',
      'U hřídele následuje příprava polotovaru, středění, hrubování, případné tepelné zpracování a dokončení.',
      'Kusový čas patří výrobě jednoho dílu, seřizovací čas přípravě pracoviště a průběžná doba zahrnuje čekání i dopravu.',
      'Neshodu je nutné oddělit, označit, zaznamenat, najít příčinu a po nápravě ověřit.',
      'Bezpečnost, kvalita, opakovatelnost a hospodárnost se posuzují během celého procesu, ne až na konci.'
    ];
    topicSummaryAlternatives[18]=[
      ['Postup odpovídá na otázky co, z čeho, v jakém pořadí, na čem a čím vyrábět.','Technologický proces mění tvar, rozměr, vlastnosti nebo polohu součástí.','Kusová výroba je pružná, hromadná využívá specializaci a automatizaci.','Hlavní procesy: odlévání, tváření, obrábění, spojování, tepelné zpracování, úpravy povrchu a montáž.','Výkres určuje rozměry, tolerance, materiál a jakostní požadavky.','Polotovar se volí podle tvaru, materiálu a hospodárnosti včetně nutného přídavku.','Postup určí stroje, upnutí, nástroje, řezné podmínky a kontrolní body.','Dokumentace musí být srozumitelná a navázaná na platnou revizi.','Mezioperační kontrola odhalí odchylku dříve, než vznikne větší neshodná dávka.','Výrobní náklady tvoří materiál, práce, strojní čas, nástroje, energie a přípravky.'],
      ['Výrobní proces zahrnuje také dopravu a kontrolu, technologický proces přímo mění součást.','Operace je ucelená část výroby prováděná na jednom pracovišti.','Velikost série ovlivňuje vybavení, přípravky a organizaci toku materiálu.','Postup začíná rozborem tvaru, tolerancí, drsnosti, materiálu a funkčních ploch.','Základny se připravují brzy, aby další upnutí bylo přesné a opakovatelné.','Hrubování odebírá většinu přídavku; dokončování dosahuje konečných tolerancí a povrchu.','U stupňovité hřídele se kontrolují průměry, házení, povrch a označení.','Průvodka zaznamenává průchod výrobou, operační návod popisuje konkrétní činnost.','Při neshodě se dávka oddělí a příčina hledá ve výkresu, materiálu, upnutí, nástroji nebo měření.','Bezpečný a hospodárný postup musí splnit požadavky výkresu a průběžně ověřovat kvalitu.']
    ];
    const vrtakyQuoteSets=[
      [
        'Při vrtání na soustruhu se otáčí obrobek upnutý ve vřetenu, zatímco vrták je upnutý v koníku a neotáčí se.',
        'Pinola koníku posouvá vrták v ose obrobku do materiálu.',

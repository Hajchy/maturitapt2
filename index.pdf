</style><style>
    .hero{padding-top:20px}.hero h1{font-size:clamp(42px,6vw,64px);line-height:.98;margin:12px 0}.hero .eyebrow{font-size:11px;letter-spacing:.16em}.hero p{font-size:15px;line-height:1.45;max-width:550px}.searchbox label{font-size:11px;margin-bottom:9px}.search-field input{height:47px;font-size:14px}.search-icon{font-size:17px}.ask-button{flex-basis:31px;height:31px;font-size:19px}
    @media(max-width:720px){.hero{padding-top:24px}.hero h1{font-size:clamp(42px,6vw,64px);margin:12px 0}.hero p{font-size:15px}.search-field input{height:47px}}
</style><style>
    .hero{grid-template-columns:minmax(300px,.7fr) minmax(0,1.3fr)}.searchbox{justify-self:start;width:min(760px,94%)}
    @media(max-width:720px){.hero{display:block}.searchbox{width:100%;justify-self:stretch}}
</style><style>

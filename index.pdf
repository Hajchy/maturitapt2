    .quiz-controls{display:flex;align-items:center;gap:12px;margin-top:12px;flex-wrap:wrap}.quiz-submit-status{display:block;margin-top:9px;color:#aaa99f;font-size:12px}.quiz-item.quiz-edited .quiz-response{border-color:#d8914d;background:#211a12;box-shadow:0 0 0 1px #d8914d55}.quiz-item.quiz-edited .quiz-submit-status{color:#e3a15d}.quiz-item.quiz-correct{border-left:3px solid #8fbd78;padding-left:17px;background:linear-gradient(90deg,#18211655,transparent 50%)}.quiz-item.quiz-incorrect{border-left:3px solid #c96c68;padding-left:17px;background:linear-gradient(90deg,#28181755,transparent 50%)}.quiz-result{margin-top:22px;padding:16px;border:1px solid #3b4036;border-radius:9px;color:#d0d0c8;font-size:14px;line-height:1.6}.quiz-evaluate{display:block;margin:30px 0 12px auto}.quiz-evaluate:disabled{opacity:.6;cursor:default}.quiz-item h3{margin-bottom:12px}.quiz-response{display:block;width:100%;min-height:82px;margin-top:12px;padding:12px 14px;resize:vertical;border:1px solid #3b4036;border-radius:8px;background:#141713;color:var(--ink);font:14px/1.6 var(--sans)}.quiz-response:focus{outline:2px solid #829c6e;outline-offset:1px}.quiz-response::placeholder{color:#777970}.quiz-reveal{margin-top:10px}.quiz-answer{margin-top:12px;padding:14px 16px;border:1px solid #3a4530;border-radius:9px;background:#151a13;color:#d0d0c8;font-size:14px;line-height:1.7}@media(max-width:720px){.quiz-response{font-size:16px}.quiz-answer{padding:12px 13px}}.test-navigation{display:flex;justify-content:center;padding:20px 0 8px}.test-tab-button{border:1px solid #495343;border-radius:8px;background:#171c14;color:#c9e4aa;padding:11px 16px;font:600 12px var(--sans);cursor:pointer}.test-tab-button:hover{background:#20271b;border-color:#829c6e}.test-tab-button span{margin-left:9px;color:var(--green)}.topic-card-item{position:relative;display:flex;min-width:0;flex-direction:column}.topic-card-item>.card{width:100%;flex:1;min-height:124px}.topic-card-item .card-title-group{padding-top:20px;padding-bottom:0}@media(max-width:720px){.topic-card-item>.card{min-height:118px}}.card-summary-open{position:absolute;top:8px;right:auto;bottom:auto;left:50%;transform:translateX(-50%);z-index:2;margin:0;padding:6px 12px;border:1px solid #495343;border-radius:6px;background:#171c14;color:#b9d99f;font:600 15px var(--sans);cursor:pointer}.card-summary-open:hover{background:#20271b;border-color:#829c6e}.card-summary-open:focus-visible{outline:2px solid #93ad51;outline-offset:2px}    .card-title-group{display:flex;flex:1;min-height:0;flex-direction:column;align-items:center;justify-content:center;text-align:center}.card-title-group h2{margin:0!important}.card-author{margin-top:6px;color:#c9c9bd;font:14px/1.35 var(--sans);text-align:center}.card-author[hidden]{display:none}.card-top .status{display:none}
    @media(max-width:720px){.card-author{font-size:13px}}

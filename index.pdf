    .modal-scroll::-webkit-scrollbar-track{background:#a5c68e}
    .modal-scroll::-webkit-scrollbar-thumb{background:#355a30;border:2px solid #a5c68e;border-radius:99px}
    .modal-scroll::-webkit-scrollbar-thumb:hover{background:#294725}
</style>
<style>
    .modal-foot{justify-content:center}.modal-foot .nav-btn{display:none}
    .modal{width:min(1200px,100%)}
    .detail-lead{margin-bottom:40px;padding-bottom:24px}
    .block{padding:28px 0 32px}
    .block h3{margin-bottom:15px;color:#f0f0e9}
    .study-text{border-left:1px solid #46513d;padding-left:14px;line-height:1.85}    .study-estimate{margin:0 0 12px;padding:16px 18px;border:1px solid #3b4335;border-radius:10px;background:#11140f;color:#cecec5;font:13px/1.55 var(--sans)}
    .study-estimate-top{display:flex;justify-content:center;align-items:center;margin-bottom:10px}.study-estimate-top strong{color:#e8ebdf}
    .study-estimate-count{margin-top:10px;text-align:center;color:var(--green);font-variant-numeric:tabular-nums}.study-estimate-track{height:6px;border-radius:9px;background:#292d25;overflow:hidden}.study-estimate-track span{display:block;height:100%;border-radius:inherit;background:var(--green);transition:width .2s ease}
    .image-viewer{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:28px;background:#030403ed;backdrop-filter:blur(5px)}
    .image-viewer.open{display:flex}.image-viewer-panel{position:relative;display:flex;flex-direction:column;align-items:center;gap:12px;max-width:96vw;max-height:94vh}
    .image-viewer-panel img{display:block;max-width:94vw;max-height:86vh;width:auto;height:auto;object-fit:contain;background:#10120f;border:1px solid #34362f;border-radius:8px}
    .image-viewer-panel p{margin:0;color:#e0e0d8;font-size:13px;text-align:center}
    .image-viewer-close{position:absolute;top:10px;right:10px;z-index:1;width:38px;height:38px;border:1px solid #55584d;border-radius:50%;background:#11130fe8;color:#fff;font-size:22px;cursor:pointer}
    @media(max-width:720px){.study-figure img{height:160px}.image-viewer{padding:12px}.image-viewer-panel img{max-width:96vw;max-height:82vh}}
</style>
<style>
  /* Compact the home overview so all topic rows sit higher on screen. */
  .hero{padding-bottom:24px!important}
  .toolbar{padding-top:12px!important;margin-bottom:12px!important}
  .page{padding-bottom:22px}
  .hero:has(.search-results.show){padding-bottom:24px!important}
  @media(max-width:720px){.hero{padding-bottom:24px!important}.hero:has(.search-results.show){padding-bottom:24px!important}.toolbar{padding-top:8px!important}}
</style><style>
  .summary-modal{width:min(980px,100%);height:min(760px,100%);background:#0e120d;border-color:#46553d}
  .summary-modal .modal-head{background:#141a12;border-color:#34402e}
  .summary-detail{max-width:100%;padding:28px 34px 34px}
  .summary-detail .detail-kicker{display:inline-flex;padding:7px 10px;border:1px solid #43533a;border-radius:999px;background:#182016;color:#b9d99f;font-size:10px;letter-spacing:.11em}
  .summary-detail h2{font-size:clamp(30px,4vw,42px);margin:16px 0 20px}
  .summary-detail .summary-panel{margin:0;padding:0;border:0;background:transparent}
  .summary-points{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px;margin:0;padding:0;list-style:none;counter-reset:none}
  .summary-points li{display:flex;align-items:flex-start;gap:11px;min-width:0;padding:12px 14px;border:1px solid #303c2b;border-radius:10px;background:linear-gradient(135deg,#171d15,#111510);color:#d9ded2;font:13px/1.5 var(--sans)}
  .summary-point-number{flex:0 0 27px;height:27px;display:grid;place-items:center;border:1px solid #526a46;border-radius:8px;background:#202b1c;color:#c9e4aa;font:700 10px var(--sans);font-variant-numeric:tabular-nums}
  .summary-point-text{padding-top:3px}
  @media(max-width:720px){.summary-modal{height:min(760px,100%)}.summary-detail{padding:23px 18px 26px}.summary-points{grid-template-columns:1fr;gap:7px}.summary-points li{padding:9px 11px;font-size:12px;line-height:1.4}.summary-point-number{flex-basis:24px;height:24px}}
</style><style>
  @media(max-width:720px){.hero-copy{text-align:center}.hero-copy .eyebrow,.hero-copy h1,.hero-copy p{text-align:center}.hero-copy p{margin-inline:auto}}
  .detail-title-row{position:relative;display:block!important;padding-top:0}
  .detail-title-row h2{min-width:0;margin:14px 0 0;overflow-wrap:anywhere}
  .detail-title-row .question-search{position:absolute!important;left:auto!important;right:0!important;top:-36px!important;transform:none!important;z-index:2;width:min(390px,38%)!important;min-width:0;margin:0!important}
  .modal-close-actions{display:flex;align-items:center;flex:0 0 auto}
  @media(max-width:720px){.detail-kicker{text-align:center}.detail-title-row{padding-top:0}.detail-title-row h2{margin:12px 0 2px;text-align:center!important}.detail-title-row .question-search{position:static!important;left:auto!important;right:auto!important;top:auto!important;transform:none!important;flex:0 1 420px!important;width:min(100%,420px)!important;margin:10px auto 0!important}}
  @media(max-width:720px){.modal-head{padding-top:calc(12px + env(safe-area-inset-top))}.modal-close-actions .close{width:44px;height:44px}}
</style><style>
    .study-figure img{height:360px}
    .study-figure.focus-figure img{height:420px}
    @media(max-width:720px){.study-figure img{height:260px}.study-figure.focus-figure img{height:300px}}
    @media(max-width:430px){.study-figure img{height:220px}.study-figure.focus-figure img{height:240px}}
</style><style>
  @media (min-width:721px) and (max-height:1100px){
    html,body{height:100%;overflow:hidden}
    .page{height:100vh;height:100svh;min-height:0;display:flex;flex-direction:column;padding-top:12px;padding-bottom:10px}
    .topbar{flex:0 0 auto;padding-top:4px;padding-bottom:10px}
    .hero{flex:0 0 auto;padding-top:20px;padding-bottom:12px!important;gap:22px}
    .hero h1{font-size:clamp(40px,5vw,58px);margin:9px 0}
    .hero p{font-size:14px;line-height:1.45}
    .toolbar{flex:0 0 auto;padding:8px 0 6px!important;margin-bottom:7px!important}
    .grid{flex:1 1 auto;min-height:0;grid-template-rows:repeat(4,minmax(0,1fr));gap:6px}
    .topic-card-item{min-height:0}
    .topic-card-item>.card{height:100%;min-height:0;padding:7px 10px 6px}
    .topic-card-item .card-title-group{padding-top:8px}
    .card-summary-open{top:4px;padding:6px 12px;font-size:15px}
    .card h2{font-size:clamp(20px,1.8vw,25px);line-height:1.12;margin-bottom:4px}
    .card-author{font-size:12px;margin-top:3px}
    .card-foot{display:none}
    .test-navigation{flex:0 0 auto;padding:6px 0 0}
    .test-tab-button{padding:7px 13px}
  }
</style><style>
  .search-results{position:relative!important;top:auto!important;left:auto!important;right:auto!important;display:none;width:100%;max-height:165px;overflow:auto!important;margin:10px 0 0;padding:0;background:#171915;border:1px solid #383a34;border-radius:10px;box-shadow:0 15px 35px #000b;scroll-behavior:auto}
  .search-results.show{display:block}
  .hero:has(.search-results.show){padding-bottom:24px!important}
  @media(max-width:720px){.search-results{max-height:150px}.hero:has(.search-results.show){padding-bottom:24px!important}}
</style><style>.test-cap-button{display:grid;place-items:center;width:42px;height:42px;padding:0!important;border-radius:50%;flex:0 0 42px}.test-cap-button svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.test-cap-button:hover svg{transform:translateY(-1px)}@media(max-width:720px){.topbar{gap:12px}.test-cap-button{width:40px;height:40px;flex-basis:40px}}</style>
</head>
<body>
  <main class="page">
    <header class="topbar"><div class="brand"><span class="brandmark">m</span><span>Maturitní příprava</span></div><button id="openTestTab" class="test-tab-button test-cap-button" type="button" aria-label="Spustit test" title="Vyzkoušet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5L2 9Z"/><path d="M6 11v5c3.7 2.8 8.3 2.8 12 0v-5M22 9v6"/></svg></button><span class="course">PT2</span></header>
    <section class="hero"><div class="hero-copy"><div class="eyebrow">Tvůj osobní studijní přehled</div><h1>Maturitní otázky<span style="color:var(--green)">.</span></h1><p>Dvacet témat na jednom místě.</p></div><div class="searchbox"><label for="searchInput">VYHLEDEJ SI</label><div class="search-field"><span class="search-icon" aria-hidden="true">✳</span><input id="searchInput" type="search" placeholder="Napiš téma a já ho najdu" autocomplete="off" aria-label="Polož otázku k maturitním tématům"><button id="askButton" class="ask-button" type="button" aria-label="Odeslat otázku">↑</button></div><div class="search-results" id="searchResults" role="log" aria-live="polite" aria-label="Odpovědi asistenta"></div></div></section>
    <div class="toolbar"><div class="section-title">Přehled otázek</div></div>
    <section class="grid" id="grid" aria-label="Seznam maturitních otázek"></section>

  </main>
  <div class="overlay" id="overlay" role="presentation">
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="detailTitle">
      <header class="modal-head"><div class="modal-mark"><b>m</b><span>Maturitní otázky <span aria-hidden="true">/</span> <span id="modalCrumb">01</span></span></div><div class="question-search"><input id="questionSearchInput" type="search" placeholder="Hledat v této otázce…" aria-label="Hledat v otevřené otázce"><button id="questionSearchButton" type="button" aria-label="Vyhledat v otázce">⌕</button><span id="questionSearchCount" aria-live="polite"></span></div><div class="modal-close-actions"><button type="button" class="close" id="closeBtn" aria-label="Zavřít okno">×</button></div></header>
      <div class="modal-scroll" id="modalScroll"><article class="detail" id="detail"></article></div>
      <footer class="modal-foot"><button class="nav-btn" id="prevBtn">← Předchozí</button><span class="foot-count" id="footCount"></span><button class="nav-btn" id="nextBtn">Další →</button></footer>
    </section>
  </div>
  <div class="overlay" id="summaryOverlay" role="presentation" aria-hidden="true">
    <section class="modal summary-modal" role="dialog" aria-modal="true" aria-labelledby="summaryModalTitle">
      <header class="modal-head"><div class="modal-mark"><b>m</b><span>Rychlé shrnutí <span aria-hidden="true">/</span> Otázka <span id="summaryCrumb"></span></span></div><button class="close" id="summaryCloseBtn" type="button" aria-label="Zavřít shrnutí">×</button></header>
      <div class="modal-scroll"><article class="detail summary-detail"><div class="detail-kicker">RYCHLÉ OPAKOVÁNÍ · 10 KLÍČOVÝCH BODŮ</div><h2 id="summaryModalTitle"></h2><div class="summary-panel" id="summaryModalBody"></div></article></div>
    </section>
  </div>  <div class="image-viewer" id="imageViewer" aria-hidden="true">
    <div class="image-viewer-panel" role="dialog" aria-modal="true" aria-label="Zvětšený studijní obrázek">
      <button class="image-viewer-close" id="imageViewerClose" type="button" aria-label="Zavřít zvětšený obrázek">×</button>
      <img id="imageViewerImage" alt="">
      <p id="imageViewerCaption"></p>
    </div>
  </div>
  <script>
    const sections=[['Základní přehled','Vysvětli téma vlastními slovy. Co znamená, k čemu slouží a proč je důležité?'],['Klíčové pojmy','Sepiš důležité pojmy a ke každému krátké vysvětlení.'],['Jak to funguje','Popiš princip, jednotlivé části nebo postup krok za krokem. Přidej souvislosti a případné vzorce.'],['Příklady a využití','Uveď konkrétní příklady, praktické použití nebo ukázku, na které jde téma dobře vysvětlit.'],['Co si zapamatovat','Doplň otázky, na které se tě může komise zeptat, a stručné body k zopakování.']];
    const topicTitles={1:'Materiály',2:'Otázka 02',3:'Vrtáky',4:'Plasty',10:'Nedestruktivní zkoušky',13:'Zkoušky materiálů',14:'Soustružení',18:'Teorie strojního obrábění',19:'Výrobní postupy'};
    const topicAuthors={1:'Miroslav Zelinka',14:'Miroslav Zelinka',3:'Vojtěch Pikna',4:'Vojtěch Pikna',10:'Stanislav Hlaváč',13:'Michal Vinklárek',18:'Stanislav Hlaváč',19:'Michal Vinklárek'};
    const defaults=Array.from({length:20},(_,i)=>({title:topicTitles[i+1]||`Otázka ${String(i+1).padStart(2,'0')}`,lead:'Studijní materiál k tomuto tématu bude doplněn.',blocks:sections.map(([title,placeholder])=>({title,text:''})),done:false}));
    const notes=defaults;
    notes[12].lead='Přehled destruktivních, technologických, metalografických a chemických zkoušek: co se zkouší, jak metoda probíhá a jak správně vyhodnotit výsledek.';
    notes[12].blocks=[
      {title:'Účel a rozdělení zkoušek materiálů',text:`Zkoušením ověřujeme, zda materiál, polotovar nebo hotová součást splňuje požadavky výkresu a provozu. Výsledek ovlivňuje místo a směr odběru vzorku, jeho rozměry, stav, příprava, teplota, rychlost zatěžování i použitý přístroj. Proto musí být výsledek vždy spojen s konkrétní metodou a podmínkami.

Zkoušky dělíme na:
• mechanické – tah, tlak, ohyb, krut, tvrdost, ráz, únavu a tečení;
• technologické – ověřují vhodnost pro ohýbání, pěchování, tažení, svařování či obrábění;
• metalografické – sledují makrostrukturu, mikrostrukturu, zrno, fáze, vměstky a vady;
• chemické – stanovují obsah prvků a shodu chemického složení;
• nedestruktivní – hledají vady bez znehodnocení dílu; jejich metody jsou podrobněji v samostatném tématu.

Destruktivní zkouška vzorek poruší nebo trvale změní. Nedestruktivní zkouška kontroluje výrobek bez ztráty jeho použitelnosti, ale její citlivost závisí na zvolené metodě.`},
      {title:'Tahová a tlaková zkouška',text:`Při tahové zkoušce se normalizované zkušební těleso upevní do čelistí stroje a plynule se zatěžuje až do přetržení. Stroj zaznamenává sílu a prodloužení; z nich se vyhodnotí napětí σ a poměrná deformace ε. Zkouška ukazuje pružnou i plastickou oblast a chování materiálu před lomem.

Důležité veličiny:
• mez kluzu Re nebo smluvní mez Rp0,2 – napětí, při němž začíná významná trvalá deformace;
• pevnost v tahu Rm – nejvyšší napětí dosažené při zkoušce;
• tažnost A – prodloužení po přetržení vzhledem k původní měřené délce;
• kontrakce Z – zmenšení plochy průřezu v místě lomu.

Pružná deformace po odlehčení mizí, plastická zůstává. Tažný materiál se výrazně prodlužuje a může vytvořit krček; křehký materiál se poruší s malou plastickou deformací. Při tlakové zkoušce se vzorek stlačuje mezi deskami. Sleduje se zkrácení, deformace a trhliny; u štíhlých vzorků může výsledek zkreslit vybočení nebo tření na dosedacích plochách.`},
      {title:'Zkoušky tvrdosti: Brinell, Rockwell a Vickers',text:`Tvrdost vyjadřuje odpor proti místnímu plastickému vnikání tvrdšího tělesa. Měření je rychlé a často lze zkoušet i součást, ale vtisk může povrch trvale změnit. Před zkouškou musí být povrch čistý a vhodně připravený; vzorek musí být dostatečně silný, pevně podepřený a vtisky musí mít předepsané rozestupy.

• Brinell HBW: do povrchu se vtlačí kulička z tvrdokovu a hodnotí se průměr vtisku. Hodí se pro hrubší a nehomogenní materiály, například odlitky a výkovky.
• Rockwell HR: měří se hloubka vtisku při předepsaném zatížení. Různé stupnice používají jiné vnikací těleso a sílu; metoda je rychlá pro sériové díly a tepelně zpracované vrstvy.
• Vickers HV: diamantový čtyřboký jehlan vytvoří vtisk, jehož úhlopříčky se změří. Metoda má široké použití včetně tenkých vrstev a malých součástí při správně zvoleném zatížení.

Převody mezi HBW, HR a HV jsou pouze přibližné a platí jen pro určité materiály a rozsahy. Tvrdost proto nelze bez ověření považovat za přímou náhradu tahové zkoušky.`},
      {title:'Rázová, únavová a creepová zkouška',text:`Rázová zkouška Charpy hodnotí energii spotřebovanou na přeražení vrubového vzorku kyvadlovým kladivem. Výsledek charakterizuje vrubovou houževnatost a citlivost ke křehkému lomu. Ovlivňuje jej teplota, tvar a orientace vrubu i struktura materiálu.

Při únavové zkoušce se vzorek opakovaně nebo proměnně zatěžuje, například střídavým tahem a tlakem či ohybem. Sleduje se počet cyklů do vzniku trhliny nebo lomu. Únavový lom může nastat i při napětí nižším, než je pevnost zjištěná jednorázovou tahovou zkouškou; důležité jsou vruby, stav povrchu, zbytková napětí a průběh zatížení.

Zkouška tečení (creepu) sleduje časově závislou deformaci při dlouhodobém zatížení, často za zvýšené teploty. Materiál se může postupně prodlužovat a nakonec porušit, i když zatížení zůstává konstantní. Pro dlouhodobě nebo cyklicky zatíženou součást proto nestačí znát pouze pevnost v tahu.`},
      {title:'Technologické zkoušky',text:`Technologické zkoušky napodobují konkrétní výrobní operaci a ověřují, zda ji materiál zvládne bez nepřípustných vad. Používá se předepsaný vzorek, nástroj a způsob vyhodnocení.

• Ohybová zkouška: vzorek se ohýbá přes trn nebo mezi podporami; sledují se trhliny a tvárnost.
• Pěchovací zkouška: krátký vzorek se stlačuje na předepsanou výšku; odhaluje trhliny a nehomogenity při objemovém tváření.
• Zkouška hlubokého tažení nebo lemování: ověřuje tvářitelnost plechu a chování jeho okraje.
• Zkouška svařitelnosti: hodnotí svar, jeho lom, tvrdost nebo strukturu.
• Zkouška obrobitelnosti: porovnává opotřebení nástroje, řezné síly, jakost povrchu či dosažitelnou produktivitu.

Výsledek má význam jen za předepsaných podmínek; jeden vzorek nelze automaticky zobecnit na každou součást a výrobní dávku.`},
      {title:'Metalografické a chemické zkoušky',text:`Metalografie zkoumá strukturu okem, lupou nebo mikroskopem. Vzorek se odebere a obvykle se připraví řezem, případně zalije, vybrousí, vyleští a naleptá, aby se zvýraznily strukturní složky.

• Makroskopické zkoumání hledá větší nehomogenity, vady odlitků a svarů, makrosegregaci, průběh vláken a charakter lomu.
• Mikroskopické zkoumání hodnotí velikost zrna, fáze, vměstky, mikrotrhliny a stav po tepelném zpracování.
• U povrchových vrstev se ověřuje jejich hloubka a rovnoměrnost, například po cementování či nitridování.

Chemická analýza stanovuje obsah prvků a ověřuje, zda složení odpovídá požadavku. Používají se laboratorní a přístrojové metody, například spektrometrie. Samotné chemické složení neurčuje všechny vlastnosti: rozhoduje i struktura, tváření a tepelné zpracování. Proto se podle účelu kombinují chemické, mechanické a strukturní zkoušky.`},
      {title:'Volba zkoušky, protokol a vyhodnocení',text:`Metodu volíme podle toho, co potřebujeme zjistit. Pevnost a tažnost ověřuje tahová zkouška; tvrdost Brinell, Rockwell nebo Vickers podle materiálu, tloušťky a rozsahu; chování při nárazu rázová zkouška; životnost při cyklech únavová zkouška a dlouhodobou deformaci za tepla creepová zkouška. Vhodnost pro výrobu ověřují technologické zkoušky. Vady hotového dílu bez jeho zničení hledají metody NDT.

Protokol musí obsahovat identifikaci materiálu, výrobku a vzorku, metodu a podmínky zkoušky, naměřené hodnoty s jednotkami, požadovaná kritéria a jednoznačné vyhodnocení shody. Uvede se také datum a odpovědná osoba nebo laboratoř. Bez uvedení metody a podmínek nelze výsledek správně porovnávat.

U maturity vždy vysvětli: co se zkouší, jak zkouška probíhá, jakou veličinu nebo vadu zjišťuje a co může výsledek ovlivnit.`}
    ];
    notes[18].lead='Výrobní postup převádí požadavky výkresu na bezpečný, přesný a hospodárný sled operací – od polotovaru až po kontrolu hotového výrobku.';
    notes[18].blocks=[
      {title:'Výroba a výrobní proces',text:`Výroba mění materiál, polotovar nebo nakupované díly na výrobek. Výrobní proces zahrnuje vlastní přeměnu i manipulaci, dopravu, kontrolu, skladování a přípravu pracoviště. Technologický proces je plánovaná část výroby, při níž se mění tvar, rozměr, vlastnosti nebo vzájemná poloha součástí.

Operace je ucelená část procesu prováděná na jednom pracovišti bez změny upnutí nebo podle stanoveného pravidla. Menší část operace může tvořit úsek nebo jednotlivý záběr nástroje. Pracoviště zahrnuje stroj, zařízení a místo, kde se práce provádí.

Výrobní postup odpovídá na otázky: co vyrobit, z čeho, v jakém pořadí, na čem, čím a jak výsledek zkontrolovat. Musí respektovat výkres, materiál, možnosti provozu, požadovanou jakost, bezpečnost i náklady.`},
      {title:'Druhy výroby a technologické procesy',text:`Podle množství a opakovatelnosti rozlišujeme kusovou výrobu (jednotlivé kusy, univerzální vybavení), malosériovou (menší opakované dávky), sériovou (opakované dávky s vhodnými přípravky) a hromadnou (velké počty stejných kusů, vysoká specializace a automatizace). Typ výroby ovlivňuje uspořádání pracovišť, investice do přípravků i čas na kus.

Hlavní technologické procesy jsou odlévání, tváření, obrábění, spojování (svařování, pájení, lepení či mechanické spoje), tepelné zpracování, povrchové úpravy a montáž. Při odlévání získá ztuhlý materiál tvar dutiny formy; tváření mění tvar plastickou deformací; obrábění odebírá materiál; tepelné zpracování mění strukturu a vlastnosti řízeným ohřevem a ochlazením.

Technologické uspořádání sdružuje stroje stejného druhu a pružně zvládá různé zakázky. Předmětné uspořádání řadí pracoviště podle toku výrobku. Linka má pevný sled operací, vysoký výkon a menší pružnost při změně výrobku.`},
      {title:'Jak se sestavuje výrobní postup',text:`Technolog postupuje od požadavků součásti k proveditelnému pořadí práce. Nejprve rozebere výkres: tvar, rozměry, tolerance, drsnost, materiál, tepelné zpracování, závity a funkční plochy. Poté zvolí polotovar – tyč, plech, výkovek, odlitek nebo profil – a stanoví potřebné přídavky.

Následuje pořadí operací, stroje a pracoviště, upnutí, nástroje, přípravky a měřidla. Zahrubování obvykle předchází dokončování; základny pro ustavení je vhodné vytvořit včas. Přesné plochy se dokončují s dostatečnou tuhostí a odpovídajícím přídavkem. U náročné součásti může mezi hrubováním a dokončením následovat tepelné zpracování.

Technolog stanoví řezné podmínky, chlazení, časy a kontrolní body. Nakonec ověří proveditelnost, rizika, náklady, bezpečnost a úplnost dokumentace. Přídavek polotovaru musí stačit na odstranění okují a nepřesností; nadměrný přídavek zvyšuje spotřebu materiálu i čas obrábění.`},
      {title:'Technologická dokumentace',text:`Dokumentace předává pracovišti jednoznačné a aktuální pokyny navázané na správnou revizi výkresu.

• Výkres součásti určuje tvar, rozměry, tolerance, materiál, drsnost a další požadavky.
• Technologický postup stanoví operace, pracoviště, ustavení, nástroje, měřidla, parametry a kontrolní body.
• Operační návod podrobně popisuje jednu operaci, pracovní kroky, bezpečnost, nástroje, upnutí a kontrolu.
• Průvodka nebo výrobní karta identifikuje zakázku a díl, řadí operace a zaznamenává průchod výrobou.
• Kontrolní plán určuje kontrolované vlastnosti, četnost, měřidla, odpovědnost a reakci při neshodě.
• Kusovník vypisuje součásti a materiály výrobku nebo podsestavy.

U každé operace uveď její číslo a název, označení dílu, stroj, upnutí, nástroj, přípravek, měřidlo, pracovní kroky, důležité parametry, požadovaný výsledek, kontrolu a bezpečnostní upozornění. Změny výkresu, materiálu nebo metody se promítnou do platné revize.`},
      {title:'Příklad výrobního postupu: stupňovitá hřídel',text:`Uvažujme hřídel z kruhové tyče s několika průměry, čely, osazeními a drážkou. Skutečný postup se vždy upraví podle výkresu, materiálu, série a vybavení.

1. Příprava polotovaru: tyč se na pile uřízne s přídavkem, ověří se délka a identifikace materiálu.
2. Zarovnání čela a středicí důlek: na soustruhu se vytvoří základní čelo a středicí důlek.
3. Hrubování vnějších průměrů: odebere se většina přídavku; štíhlá hřídel se podle potřeby podepře koníkem nebo obrábí mezi hroty.
4. Tepelné zpracování: provede se jen tehdy, pokud jej předepisuje výkres; ověří se tvrdost a deformace.
5. Dokončení průměrů a čel: soustružením nebo broušením se dosáhne tolerance a jakosti, rozměry se měří vhodným měřidlem.
6. Drážky, závity a sražení hran: dokončí se funkční prvky a odstraní otřepy.
7. Výstupní kontrola a ochrana: ověří se rozměry, házení, povrch a označení; následně se použije předepsaná ochrana.

Pořadí je důležité: hrubování může součást zahřát nebo uvolnit pnutí. Proto se někdy ponechá přídavek a konečný rozměr se dokončí po tepelném zpracování. Podepření mezi hroty omezuje průhyb.`},
      {title:'Čas, kapacita a hospodárnost',text:`Kusový čas je doba výroby jednoho kusu v operaci. Seřizovací čas připravuje stroj, program, nástroj a upnutí pro dávku. Průběžná doba zahrnuje cestu zakázky výrobou, čekání, dopravu i kontroly. Výrobní dávka je množství kusů zpracovaných společně; kapacita vyjadřuje množství práce nebo výrobků za určité období.

Postup ovlivňuje vytížení strojů, zásobu rozpracované výroby a náklady. Porovnává se materiál, práce, strojní čas, nástroje, energie a přípravky. Dražší polotovar může snížit obrábění; speciální přípravek se může vyplatit ve velké sérii, ale ne u jediného kusu. CNC a automatizace zvyšují opakovatelnost a mohou zkrátit čas, vyžadují však programování, seřízení a kontrolu.

Při volbě sleduj bezpečnost, kvalitu, opakovatelnost, průběžnou dobu, využití strojů, spotřebu materiálu a náklady na dávku i kus.`},
      {title:'Kontrola kvality, neshoda a bezpečnost',text:`Kontrola může být vstupní (materiál a polotovar), mezioperační (rozměry po důležité operaci, přídavky, ustavení a nástroj), výstupní (rozměry, tvar, povrch, funkce, označení) nebo procesní (stabilita zařízení, parametry a četnost neshod). Rozsah se volí podle rizika a důležitosti vlastnosti.

Při zjištění neshody odděl podezřelou dávku, označ a zaznamenej kus a zjisti příčinu – může být ve výkresu, materiálu, upnutí, nástroji, parametrech, měření nebo lidském faktoru. Opravu neprováděj svévolně. Po nápravě ověř výsledek a podle potřeby uprav dokumentaci či kontrolní plán.

Před prací zkontroluj stroj, nástroje, pracoviště a kryty. Používej předepsané ochranné prostředky a dodržuj návod. Nebezpečnou situaci oznam a stroj odstav stanoveným způsobem. Kvalita nevzniká až závěrečnou kontrolou, ale návrhem postupu, správným seřízením, školením, údržbou a průběžným ověřováním.`},
      {title:'Osnova maturitní odpovědi',text:`Při ústní odpovědi nejprve definuj výrobní a technologický proces a vysvětli, co výrobní postup zajišťuje. Uveď druhy výroby podle velikosti a opakovatelnosti a základní technologické procesy. Potom popiš tvorbu postupu od rozboru výkresu přes polotovar, operace, stroj, upnutí a nástroje až po kontrolu.

Jako příklad popiš stupňovitou hřídel a zdůvodni pořadí: příprava polotovaru, zarovnání a středění, hrubování, případné tepelné zpracování, dokončení, funkční prvky a kontrola. Zmiň dokumentaci, čas a náklady, bezpečnost a řešení neshody.

Zapamatuj si otázky: co, z čeho, v jakém pořadí, na čem a čím se vyrábí; jaký výsledek se požaduje a jak se bezpečně ověří.`}
    ];
    notes[3].lead='Nový přehled shrnuje polymerní strukturu a vlastnosti plastů, běžné materiály a výrobky, technologie zpracování, obrábění, kontrolu kvality, recyklaci i bezpečnost.';
    notes[3].blocks=[
      {title:'Plasty, polymery a základní pojmy',text:`Plasty jsou technické materiály založené na polymerech. Jejich vlastnosti lze upravovat složením směsi, přísadami a výrobním postupem. Mnoho běžných polymerů vychází z petrochemických surovin, například z ropy a zemního plynu; existují také polymery z obnovitelných surovin. Biologický původ sám o sobě neznamená biologickou rozložitelnost.

Základní pojmy:
• Termoplast – při zahřátí měkne nebo taje a po ochlazení tuhne; tvarování lze opakovat, ale materiál se může tepelně degradovat.
• Reaktoplast – během vytvrzení nevratně mění strukturu; po vytvrzení se znovu netaví a při vysoké teplotě se rozkládá.
• Elastomer – pružný materiál, který se po deformaci z velké části vrací do původního tvaru.
• Kompozit – materiál, v němž polymerní matrice spolupracuje s výztuží, například se skelnými nebo uhlíkovými vlákny.
• Granulát – drobné částice polymeru, běžná vstupní surovina pro zpracování termoplastů.

Běžné zkratky: PE – polyethylen, PP – polypropylen, PVC – polyvinylchlorid, PS – polystyren, PET – polyethylentereftalát, PA – polyamid a PC – polykarbonát.`},
      {title:'Struktura polymerů a rozdělení plastů',text:`Vlastnosti polymeru závisejí na délce a uspořádání řetězců, jejich vazbách, krystalinitě, molekulové hmotnosti i přísadách.

• Termoplasty mají převážně lineární nebo větvené řetězce bez trvalé prostorové sítě. Zahřátím měknou či tají, ochlazením tuhnou. Patří sem například PE, PP, PVC, PS, PET, PA a PC.
• U reaktoplastů se při vytvrzování vytvoří prostorově zesítěná struktura. Po vytvrzení se znovu neroztaví; příkladem jsou epoxidové, fenolformaldehydové a melaminové pryskyřice.
• Elastomery mají pružné řetězce, které se po deformaci vracejí. Kaučuk se často vulkanizuje na pryž; používají se také silikonové elastomery.

Amorfní termoplasty mají neuspořádané řetězce a při zahřívání měknou v širším teplotním rozmezí. Semikrystalické termoplasty obsahují krystalické oblasti i amorfní část; mívají výraznější teplotu tání a jejich smrštění může být větší a směrově závislé. Zapamatování: termoplast lze opakovaně změkčit, vytvrzený reaktoplast znovu neroztavíme a elastomer je pružný. Opakovaná tavitelnost ovšem neznamená neomezenou recyklovatelnost.`},
      {title:'Vlastnosti plastů a přísady',text:`Plasty jsou obvykle lehčí než kovy, odolávají korozi a často mají malou tepelnou či elektrickou vodivost. Pevnost, tuhost, houževnatost a teplotní odolnost se výrazně liší podle druhu, teploty, doby zatížení a výroby. Plasty mohou být houževnaté i křehké, při dlouhodobém zatížení mohou téct a teplo či tření je mohou změkčit nebo rozložit. Vodu a některé chemikálie snášejí dobře, jiná rozpouštědla nebo oleje je mohou napadat. UV záření, kyslík a teplo mohou způsobit změnu barvy, křehnutí a ztrátu pevnosti.

Přísady upravují vlastnosti nebo zpracování:
• plniva a výztuže snižují cenu nebo mění tuhost, pevnost a rozměrovou stabilitu; například skelná vlákna
• změkčovadla zvyšují ohebnost a měkkost některých směsí, například PVC
• stabilizátory zpomalují degradaci teplem, světlem nebo oxidací
• barviva a pigmenty dodávají barvu či kryvost
• zpomalovače hoření omezují vznícení nebo šíření plamene podle konkrétní formulace
• maziva a procesní přísady zlepšují tok taveniny, odformování či zpracovatelnost

Dva výrobky ze stejného polymeru mohou mít různé vlastnosti kvůli přísadám, výztuži, orientaci řetězců, procesu a podmínkám použití.`},
      {title:'Příklady plastů a výrobků',text:`Stejný základní polymer lze podle složení a výroby využít různě. Typické příklady z přehledu:
• PET – nápojová lahev nebo textilní vlákno; průhlednost a pevnost závisí na konkrétním typu a konstrukci.
• PE – sáček, fólie či nádoba; lehký, houževnatý a chemicky odolný.
• PP – potravinová krabička nebo víčko; nízká hustota, odolnost a dobrá únavová životnost při ohýbání.
• PVC – potrubí a kabelový plášť; lze vyrábět tuhé i měkčené směsi.
• EPS – ochranný obal nebo tepelná izolace; pěna je lehká a tlumí nárazy či omezuje přenos tepla.
• PA – ozubené kolo nebo pouzdro; odolnost proti opotřebení a dobré mechanické vlastnosti.

Jde o běžné příklady, nikoli jediné možné použití. Výrobek se volí podle požadovaných vlastností, konstrukce a technologie; samotná značka polymeru nezaručuje stejné chování každého výrobku.`},
      {title:'Technologie zpracování plastů',text:`Technologie se volí podle skupiny polymeru, tvaru výrobku, velikosti série, přesnosti a ekonomiky. Termoplasty se často zpracovávají jako tavenina, reaktoplasty se při tváření vytvrzují.

• Vstřikování – granulát se roztaví v plastikační jednotce a tavenina se vstříkne do uzavřené formy. Hodí se pro složité výrobky i velké série.
• Vytlačování (extruze) – tavenina se nepřetržitě protlačuje hubicí; vznikají trubky, profily, fólie nebo desky.
• Vyfukování – tlak vzduchu roztáhne zahřátý polotovar ke stěnám formy; vyrábějí se duté nádoby.
• Tvarování za tepla – zahřátá deska či fólie se přitlačí k formě podtlakem, přetlakem nebo mechanicky.
• Lisování reaktoplastů – dávka se vloží do vyhřáté formy, tlakem vytvaruje a ve formě vytvrdí.
• Válcování (kalandrování) – plastická směs prochází mezi válci; vyrábějí se například desky a fólie.
• Pěnění – v polymeru se vytvoří buněčná struktura, která snižuje hustotu a zlepšuje izolační vlastnosti.`},
      {title:'Princip technologií a názvy výrobků',text:`Při lisování se do vyhřáté formy vloží odměřená dávka prášku, granulátu nebo polotovaru. Po uzavření formy tlak rozvede hmotu do dutiny. Reaktoplast se vytvrdí; termoplast se před otevřením ochladí.

Při vstřikování šnek dopravuje, zahřívá a homogenizuje granulát. Tavenina se vstříkne do uzavřené formy, následuje dotlak a chlazení nebo vytvrzení. Potom se forma otevře a výrobek vyjme. Sledují se teploty, tlak, rychlost plnění, dotlak a doba chlazení.

U vytlačování šnek v extrudéru dopravuje a plastikuje materiál. Hubice určí průřez, po ní následuje kalibrace, chlazení a dělení na délku. Při vyfukování tlak vzduchu roztáhne zahřátý dutý polotovar ke stěnám formy. Při odlévání se kapalná pryskyřice nechá ztuhnout nebo vytvrdit; forma se může pomalu otáčet pro vznik dutého dílu. Zahřátá deska při tvarování kopíruje negativní dutinu formy nebo se napíná přes pozitivní tvar. Výrobek se po ochlazení sejme a často ořízne.

Podle technologie vzniká odlitek, výlisek nebo výstřik. Termoplasty se často dodávají jako granulát, reaktoplastové směsi také jako prášek, pasta či kapalina a kaučukové směsi se následně vulkanizují. Materiály chraňte před vlhkostí a záměnou podle pokynů výrobce.`},
      {title:'Parametry výroby a typické vady',text:`Při zpracování kontrolujte teplotu materiálu a formy, tlak, rychlost plnění, dobu cyklu, chlazení a vlhkost granulátu. Konkrétní nastavení ověřujte v technickém listu a na zařízení; neexistuje univerzální hodnota pro všechny plasty.

Typické vady a jejich možné příčiny či opatření:
• nedostříknutí – nízká teplota nebo tlak, krátké plnění či špatné odvzdušnění; zkontrolovat materiál, teplotní profil a parametry stroje
• otřepy – příliš vysoký tlak, malá uzavírací síla nebo opotřebená forma; prověřit uzavření, tlak a dělicí rovinu
• propadliny a dutiny – nedostatečný dotlak či chlazení nebo nerovnoměrná tloušťka stěn
• deformace po vyjmutí – nerovnoměrné chladnutí, smrštění nebo příliš brzké vyhození
• stříbrné šmouhy či bubliny – vlhký materiál, vzduch nebo degradace taveniny; sušit podle předpisu a ověřit teplotu i odvzdušnění
• spáleniny – zachycený vzduch, vysoká teplota nebo příliš dlouhá doba setrvání

U vstřikování si zapamatujte cyklus: plastifikace, uzavření formy, vstřik a dotlak, chlazení či vytvrzení, otevření a vyhození. Vady hledejte systematicky; může se kombinovat konstrukce dílu, stav formy, materiál i nastavení procesu.`},
      {title:'Obrábění a spojování plastů',text:`Plasty lze soustružit, frézovat, vrtat, řezat a brousit. Kvůli nižší tepelné vodivosti a pružnosti se mohou při nevhodném obrábění tavit, mazat, deformovat nebo vytrhávat.

• Používejte ostrý nástroj a vhodnou geometrii; tupý břit zvyšuje tření a teplotu.
• Obrobek podepřete a upněte bez nadměrného stlačení.
• Řeznou rychlost a posuv volte podle konkrétního plastu a zajistěte odvod třísky i tepla.
• U měkkých a houževnatých plastů sledujte dlouhé třísky; zjistěte, zda materiál obsahuje abrazivní výztuž.

Způsoby spojování: svařováním se místně zahřejí vhodné termoplasty (horkým nástrojem, horkým plynem, ultrazvukem nebo třením); lepidlo se volí podle polymeru, povrchu a namáhání; mechanické spoje používají šrouby, západky či nýty a musí počítat s tečením plastu; zalití a laminování se uplatňuje hlavně u pryskyřic a kompozitů. Přílišné tření při obrábění může plast změkčit a zhoršit rozměr i povrch.`},
      {title:'Kontrola materiálu a kvality výrobku',text:`Před zpracováním ověřte identitu materiálu, šarži, stav granulátu a požadavky na výrobek. U hygroskopických polymerů, například některých polyamidů a polyesterů, může vlhkost při tavení způsobit vady nebo zhoršit vlastnosti. Sušení provádějte podle předpisu konkrétního materiálu, nikoli odhadem.

Kontrola zahrnuje správný druh a dohledatelnost šarže, vlhkost a sušení, rozměry a tvar kvůli smrštění či deformaci, vizuální prohlídku povrchových vad, mechanické zkoušky pevnosti, houževnatosti nebo tvrdosti a funkční zkoušku v provozních podmínkách.

Recyklační kódy a materiálové značky pomáhají s identifikací, ale samy nezaručují, že lze výrobek místně recyklovat. Pro technickou výrobu rozhoduje přesná specifikace polymeru, výztuže, přísad a výkres. Granulát skladujte uzavřený, chraňte před vlhkostí, prachem, teplem a záměnou šarží.`},
      {title:'Recyklace, životní prostředí a bezpečnost',text:`Nakládání s plastovým odpadem zahrnuje předcházení odpadu, opětovné použití, třídění, recyklaci a další využití. Praktická recyklovatelnost závisí na druhu polymeru, čistotě, barvě, přísadách, konstrukci výrobku a dostupné technologii.

• Opětovné použití – výrobek se používá znovu.
• Mechanická recyklace – odpad se třídí, čistí, drtí a taví na druhotnou surovinu; znečištění a degradace mohou snížit kvalitu.
• Chemická recyklace – odpad či polymer se chemicky rozloží na suroviny nebo jiné produkty; přínosy závisejí na konkrétním procesu.
• Energetické využití – odpad slouží jako zdroj energie, nejde o materiálovou recyklaci.
• Skládkování – materiál se nevrací do výroby a může dlouhodobě zatěžovat prostředí.

Omezujte zbytečné jednorázové výrobky a třiďte podle místních pravidel. Směsi materiálů a znečištění recyklaci komplikují. Biologický původ a biologická rozložitelnost jsou odlišné vlastnosti.

Při zahřívání či rozkladu plastu mohou vznikat škodlivé výpary: zajistěte odsávání a řiďte se bezpečnostním listem. Používejte ochranné brýle a další předepsané prostředky. Třísky odstraňujte bezpečně, s pryskyřicemi, lepidly a rozpouštědly dodržujte pokyny výrobce a chraňte pokožku. Nezahřívejte neznámý plast v uzavřeném prostoru a nemíchejte odpady neznámého složení.`},
      {title:'Otázky k maturitě a osnova odpovědi',text:`Procvičte si: Jak se liší amorfní a semikrystalické termoplasty? Jak se plasty dělí podle chování při zahřátí? Jaký je rozdíl mezi termoplastem a reaktoplastem? Uveďte vlastnosti a použití PE, PP, PVC a PET. K čemu slouží přísady? Vysvětlete vstřikování nebo vytlačování. Jak se plasty obrábějí a jaké jsou možnosti jejich recyklace?

Osnova ústní odpovědi:
1. Stručně definujte plasty a uveďte základní suroviny.
2. Popište rozdělení podle struktury a chování při zahřívání.
3. Vysvětlete vlastnosti a vliv přísad.
4. Uveďte příklady polymerů a výrobků.
5. Popište vybranou technologii zpracování a její postup.
6. Zmiňte obrábění, spojování, kontrolu, recyklaci a bezpečnost.

Shrnutí: Plasty jsou materiály založené na polymerech. Dělí se na termoplasty, reaktoplasty a elastomery podle struktury a chování při teple. Jejich vlastnosti upravují přísady a volba technologie. Při návrhu a zpracování je třeba řešit také stárnutí, kvalitu, recyklaci a bezpečnost.`}
    ];
    notes[3].figures={
      1:[{src:'data:image/svg+xml;base64,',alt:'Schémata řetězcové struktury termoplastu, elastomeru a reaktoplastu',caption:'Řetězce termoplastu, pružně zesítěný elastomer a prostorově zesítěný reaktoplast.',wide:true}],
      3:[{src:'data:image/svg+xml;base64,',alt:'Příklady plastových výrobků z PET, PE, PP, PVC, EPS a PA',caption:'Příklady výrobků z běžných polymerů uvedené v přehledu.',wide:true}],
      4:[{src:'data:image/svg+xml;base64,',alt:'Schéma vstřikování a vytlačování plastů',caption:'Vstřikování do uzavřené formy a kontinuální vytlačování přes hubici.',wide:true}]
    };
    notes[2].lead='Přehled konstrukce a použití vrtáků, jejich upnutí a správného vrtání na soustruhu. Součástí jsou zásady volby nástroje, řezné podmínky, údržba i bezpečnost.';
    notes[2].blocks=[
      {title:'Princip vrtání na soustruhu',text:`Při vrtání na soustruhu se otáčí obrobek upnutý ve vřetenu, zatímco vrták je upnutý v koníku a neotáčí se. Pinola koníku posouvá vrták v ose obrobku do materiálu. Osy vřetena a vrtáku musí být souosé; správně seřízený koník proto zásadně ovlivňuje přesnost otvoru.

Soustruh se používá zejména pro vrtání otvorů do čel rotujících součástí. Vrták musí být pevně a souose upnutý, obrobek bezpečně sevřený ve sklíčidle a koník zajištěný na loži. Při hlubších otvorech je nutné pravidelně přerušovat posuv a odvádět třísky.`},
      {title:'Konstrukce šroubovitého vrtáku',text:`Běžný šroubovitý vrták se skládá ze stopky, krčku a pracovní části zakončené hrotem.

• Stopka slouží k upnutí; bývá válcová nebo kuželová (Morse).
• Krček spojuje stopku s pracovní částí a může nést označení nástroje.
• Pracovní část má dvě šroubovité drážky. Ty vytvářejí řezné hrany a odvádějí třísky z otvoru.
• Hrot tvoří dvě hlavní břity a příčné ostří. Oba hlavní břity mají být stejně dlouhé a souměrné vůči ose.
• Jádro uprostřed vrtáku zajišťuje jeho pevnost; směrem ke stopce se obvykle zesiluje.

Drážky a jejich geometrie ovlivňují řezání, odvod třísek i tuhost nástroje. Vrták s dlouhou pracovní částí je méně tuhý a snadněji se vychýlí než krátký vrták.`},
      {title:'Geometrie a úhly vrtáku',text:`Řeznou geometrii tvoří zejména úhel hrotu, úhel čela a úhel hřbetu. Úhel špičky běžného vrtáku pro ocel bývá přibližně 118°. Pro jiné materiály a nástroje se geometrie může lišit; při broušení je důležité zachovat souměrnost obou břitů.

Oba hlavní břity mají mít stejnou délku a stejný úhel. Nesouměrně nabroušený vrták řeže převážně jedním břitem, otvor může být větší než jmenovitý průměr, nástroj se zahřívá a rychleji opotřebuje. Příčné ostří leží uprostřed hrotu a při vrtání materiál spíše vytlačuje než účinně řeže.`},
      {title:'Materiály vrtáků a povlaky',text:`Materiál nástroje se volí podle obráběného materiálu, požadované životnosti a řezných podmínek.

• Nástrojová uhlíková ocel je levná, ale má nižší tepelnou odolnost; hodí se pro nenáročné práce a nižší rychlosti.
• Rychlořezná ocel (HSS) je běžná univerzální volba. Zachovává tvrdost i při zahřátí a používá se na oceli i řadu dalších kovů.
• Kobaltová rychlořezná ocel (HSS-Co) lépe snáší vyšší teploty a hodí se například pro nerezové a pevnější materiály.
• Slinutý karbid je velmi tvrdý a umožňuje vyšší řezné rychlosti, ale je křehčí a citlivější na rázy a chvění. Vyžaduje tuhé upnutí a stabilní podmínky.

Povlaky, například nitrid titanu (TiN), mohou snížit tření, omezit opotřebení a zvýšit životnost. Povlak nezachrání tupý nebo nesprávně zvolený vrták. U hliníku, plastů, dřeva a zdiva se volí nástroj s geometrií určenou přímo pro daný materiál; do zdiva se používá vrták s tvrdokovovým plátkem.`},
      {title:'Druhy vrtáků a upnutí',text:`Nejčastějšími vrtáky jsou šroubovité vrtáky. Krátké vrtáky jsou tužší a vhodné pro přesné vedení, dlouhé vrtáky dosáhnou do hlubších míst, ale snáze se prohnou. Středicí vrták vytvoří krátké vodicí zahloubení, které pomáhá navést následný vrták.

Válcová stopka se obvykle upíná do sklíčidla. Kuželová stopka Morse se upíná přímo do odpovídajícího kužele pinoly nebo do redukčního pouzdra. Kuželové plochy musejí být čisté a nepoškozené. K vyražení kuželového nástroje z pinoly se používá vyrážecí klín.

Vrták se upíná za stopku. Čelisti sklíčidla nesmějí svírat drážky ani pracovní část, protože by se nástroj mohl uvolnit nebo poškodit. Po upnutí zkontrolujte pevnost a souosost nástroje.`},
      {title:'Postup vrtání na soustruhu',text:`1. Zkontrolujte vrták, jeho ostří, stopku a vhodnost pro obráběný materiál. Zvolte rychlost, posuv a případné chlazení.
2. Obrobek pevně upněte do sklíčidla. Odstraňte klíč sklíčidla a ověřte, že se obrobek nemůže uvolnit.
3. Vyrovnejte koník s osou vřetena, posuňte jej k obrobku a zajistěte na loži.
4. Vložte čistý vrták do pinoly koníku (případně přes sklíčidlo či pouzdro) a bezpečně ho upněte.
5. Je-li třeba přesnější navedení, nejprve vytvořte středicí důlek středícím vrtákem.
6. Zapněte vřeteno na zvolený počet otáček. Vrták přibližujte ručním posuvem pinoly plynule a v ose.
7. U hlubšího otvoru posuv přerušujte, vrták povytáhněte a umožněte odvod třísek. Při čištění třísek stroj zastavte; třísky neodstraňujte rukou.
8. Po dosažení hloubky vrták vytáhněte, zastavte stroj a zkontrolujte otvor i nástroj.

Při vrtání s protáčejícím se obrobkem je vrták v koníku nehybný v otáčení a koník poskytuje pouze osový posuv. Nepoužívejte sílu, která by nástroj ohýbala nebo obrobek vytahovala z upnutí.`},
      {title:'Řezné podmínky a výpočet otáček',text:`Základní řezné podmínky jsou řezná rychlost v, otáčky vřetena n a posuv f. Řezná rychlost závisí na materiálu obrobku, materiálu a průměru vrtáku a doporučení výrobce. Posuv f se u vrtání udává zpravidla v milimetrech na jednu otáčku; příliš velký posuv přetěžuje břity, příliš malý může způsobit tření.

Pro výpočet otáček platí:
n = [FRACTION] [m/min]

Příklad z podkladů: vrták D = 10 mm, doporučená v = 25 m/min.
n = (25 × 1000) / (3,14 × 10) ≈ 796 min⁻¹.
Pokud soustruh nemá přesně tuto hodnotu, zvolí se nejbližší nižší dostupný stupeň, například 710 ot/min.

Rychlost posuvu pinoly lze odhadnout vztahem vf = f × n. Při f = 0,15 mm/ot a n = 710 min⁻¹ vychází vf = 106,5 mm/min. Při práci je nutné respektovat tabulky výrobce, tuhost soustavy, chlazení a skutečný stav nástroje; uvedené hodnoty jsou pouze názorný příklad.`,formula:{numerator:'v × 1000',denominator:'3,14 × D'}},
      {title:'Volba, údržba a ostření',text:`Pro běžnou ocel se často volí HSS vrták, pro nerez HSS-Co a pro tuhé obrábění a vyšší rychlosti karbidový nástroj. U hliníku a plastů pomáhá vhodná ostřejší geometrie a dobrý odvod třísek; materiál může mít jiné požadavky na mazání či chlazení. Vždy vycházejte z doporučení výrobce nástroje.

Vrtáky ukládejte tak, aby se ostří vzájemně nedotýkala. Před použitím ověřte, zda není vrták tupý, prasklý, ohnutý nebo poškozený. Tupý vrták zvyšuje řezné síly a teplotu, proto se má včas nabrousit nebo vyměnit.

Při ručním ostření je nutné zachovat stejnou délku a úhel obou hlavních břitů a přiměřený hřbet. Vrták se přikládá k brusnému kotouči plynule; nepřehřívejte jej a při potřebě jej ochlazujte. Po nabroušení zkontrolujte souměrnost hrotu. Přesné ostření vyžaduje zkušenost a vhodné pomůcky.`},
      {title:'Typické závady a jejich příčiny',text:`• Otvor je větší nebo nesouměrný: zkontrolujte souměrnost břitů, stav vrtáku, házení sklíčidla a souosost koníku.
• Vrták se rychle tupí nebo přehřívá: může být zvolena příliš vysoká řezná rychlost, nevhodný nástroj, nedostatečné chlazení nebo tupé ostří.
• Vrták vibruje či se vychyluje: zkraťte vyložení, použijte tužší a kratší vrták, zlepšete upnutí obrobku a nástroje a zkontrolujte souosost.
• Třísky se hromadí v otvoru: u hlubokého vrtání přerušujte posuv a zajistěte bezpečný odvod třísek.
• Nástroj se láme: příčinou může být špatné upnutí, nesouosost, příliš velký posuv, zablokované třísky nebo ráz do křehkého karbidového nástroje.`},
      {title:'Bezpečnost práce a osnova odpovědi',text:`Před spuštěním odstraňte klíč sklíčidla, zkontrolujte upnutí obrobku i vrtáku a zajistěte koník. Používejte ochranné brýle a přiléhavý oděv; dlouhé vlasy a volné části oděvu zabezpečte. U rotujícího vřetena se nedotýkejte obrobku ani třísek, nepoužívejte rukavice a neměřte. Třísky odstraňujte háčkem nebo štětcem až po zastavení stroje. Při výměně nástroje či čištění stroj zastavte.

U ústní zkoušky postupujte od účelu a principu vrtání, přes části vrtáku a jeho geometrii k materiálům, upnutí a pracovnímu postupu. Poté vysvětlete volbu řezné rychlosti a výpočet otáček, údržbu, typické závady a zásady bezpečnosti.

Kontrolní otázky: Která část vrtáku odvádí třísky? Jak se liší válcová a Morse stopka? Proč musí být břity souměrné? Jak vypočítáte otáčky pro daný průměr a řeznou rychlost? Proč se u hlubokého otvoru přerušuje posuv? Jak bezpečně odstraníte třísky?`}
    ];
    notes[2].figures={
      0:[{src:'data:image/svg+xml;base64,',alt:'Schéma vrtání na soustruhu: obrobek se otáčí, vrták v koníku se posouvá do osy',caption:'Vrtání na soustruhu: otáčí se obrobek, vrták se posouvá pinolou koníku.',wide:true}],
      1:[{src:'data:image/svg+xml;base64,',alt:'Schéma šroubovitého vrtáku s vyznačenou stopkou, pracovní částí a hrotem',caption:'Základní části šroubovitého vrtáku.',wide:true}]
    };
    notes[13].lead='Soustružení je třískové obrábění, při kterém se obrobek otáčí a jednobřitý nástroj se posouvá. Přehled zahrnuje části soustruhu, upínání, nástroje, operace, řezné podmínky, kontrolu i bezpečnost.';
    notes[13].blocks=[
      {title:'Princip soustružení a řezné pohyby',text:`Soustružení je třískové obrábění rotačních ploch. Obrobek se otáčí kolem své osy a soustružnický nůž odebírá materiál. Výsledkem mohou být válcové a čelní plochy, kužely, drážky, závity nebo tvarové plochy. Používá se pro hřídele, čepy, pouzdra i další součásti.

• Hlavní řezný pohyb – rotace obrobku; určuje řeznou rychlost v [m/min].
• Posuv – pohyb nástroje vůči obrobku; posuv na otáčku f se udává v mm/ot.
• Přísuv – radiální nastavení hloubky řezu ap v mm.
• Pomocné pohyby – například návrat nástroje, přestavení suportu a výměna obrobku.

Podélný posuv probíhá rovnoběžně s osou Z a vytváří válcovou plochu. Příčný posuv ve směru osy X míří k ose nebo od ní a používá se při čelním soustružení a změně průměru. Šikmý posuv umožňuje soustružit kužely. Hloubka řezu ap je radiální úběr; při soustružení vnějšího průměru se průměr zmenší přibližně o 2 ap.`},
      {title:'Soustruh a jeho hlavní části',text:`Univerzální hrotový soustruh obrábí vnější i vnitřní rotační plochy. Obrobek bývá upnutý ve sklíčidle nebo mezi hroty, nástroj se upíná do nožové hlavy na suportu.

• Lože – základna stroje; vede suport a koník a zajišťuje jejich vzájemnou polohu.
• Vřeteník – obsahuje vřeteno a převody otáček; přenáší pohyb na obrobek.
• Vřeteno – hlavní otočná část, na kterou se připojuje sklíčidlo nebo unašeč.
• Suport – nese nástroj a zajišťuje podélný i příčný posuv.
• Nožová hlava – upíná soustružnický nůž a umožňuje nastavit jeho pracovní polohu.
• Koník – podpírá volný konec dlouhého obrobku; lze do něj upnout vrták nebo výstružník.
• Posuvová skříň a vodicí šroub – nastavují posuv; vodicí šroub se používá zejména pro řezání závitů.

Další druhy soustruhů: čelní pro krátké obrobky velkého průměru, revolverové pro opakovanou výrobu více operacemi, svislé neboli karuselové pro těžké rozměrné obrobky a CNC pro automatizovanou přesnou výrobu.`},
      {title:'Upínání obrobku a nástroje',text:`Způsob upnutí se volí podle tvaru, rozměrů, požadované přesnosti a tuhosti obrobku.

• Tříčelisťové samočinně středicí sklíčidlo – rychlé upnutí pravidelných kruhových nebo šestihranných polotovarů.
• Čtyřčelisťové nezávislé sklíčidlo – čelisti se nastavují jednotlivě; umožňuje upnout nepravidelný tvar nebo přesně vystředit obrobek.
• Upnutí mezi hroty – vhodné pro dlouhé hřídele; obrobek se obvykle pohání unašečem.
• Kleština – přesné upnutí menších tyčí a součástí.
• Lícní deska – pro rozměrné nebo nepravidelné obrobky.
• Pevná a pohyblivá luneta – podpírá dlouhé štíhlé obrobky a omezuje jejich průhyb či chvění.

Před upnutím očistěte dosedací plochy. Obrobek upněte bezpečně a co nejkratším vyložením; dlouhý konec podepřete. Nůž nastavte přibližně do výšky osy vřetena a s co nejmenším vyložením. Po upnutí ručně ověřte, že nic nekoliduje. Při vrtání na soustruhu se otáčí obrobek, zatímco vrták upnutý v koníku se posouvá do osy; otvor se obvykle nejprve navrtá středicím vrtákem.`},
      {title:'Soustružnické nože, geometrie a tříska',text:`Soustružnický nůž má jednu hlavní řeznou hranu. Vyrábí se z rychlořezné oceli (HSS) nebo se používá držák s vyměnitelnou břitovou destičkou ze slinutého karbidu či jiného řezného materiálu. Druh nástroje se volí podle materiálu obrobku, operace a požadovaného povrchu.

Mezi běžné nástroje patří vnější uběrací a dokončovací nože, zapichovací a upichovací nože, vnitřní vyvrtávací nože, závitové nože a tvarové nože.

• Čelo – plocha, po které odchází tříska.
• Hřbet – plocha obrácená k obrobenému povrchu; vůle omezuje tření.
• Hlavní ostří – odděluje převážnou část materiálu.
• Úhel čela γ ovlivňuje tvorbu a odchod třísky i pevnost břitu.
• Úhel hřbetu α brání tření hřbetu o obrobenou plochu.
• Úhel břitu β je klín mezi čelem a hřbetem; větší β obvykle znamená pevnější, ale méně ostrý klín.

Tříska může být plynulá, článkovaná nebo elementární. Dlouhá plynulá tříska je nebezpečná; vhodná geometrie a řezné podmínky ji mohou lámat. Třísky nikdy neodstraňujte rukou.`},
      {title:'Základní soustružnické operace',text:`• Podélné soustružení – nůž se posouvá rovnoběžně s osou; vzniká válcová plocha.
• Čelní soustružení – nůž se posouvá napříč osou a zarovnává čelo obrobku.
• Zapichování – nůž proniká radiálně do materiálu a vytváří drážku.
• Upichování – úzký nůž postupně oddělí součást od tyče.
• Vrtání a vyvrtávání – vrták vytvoří otvor; vyvrtávací nůž otvor zpřesní nebo zvětší.
• Soustružení kuželů – lze použít natočený horní suport, vyosení koníku nebo kopírovací zařízení.
• Řezání závitů – závitový nůž se synchronizovaným posuvem vytváří šroubovici.
• Rýhování – vytlačením materiálu vznikne zdrsněný povrch pro lepší úchop; nejde o běžné odřezávání třísky.

Obrábění se často dělí na hrubování, polodokončování a dokončování. Hrubování rychle odebírá větší přídavek, dokončování menším záběrem a vhodným posuvem dosahuje požadovaného rozměru a povrchu.`},
      {title:'Řezné podmínky a výpočet otáček',text:`Řezné podmínky se volí podle materiálu obrobku, řezného materiálu nástroje, tuhosti upnutí, požadované jakosti povrchu a doporučení výrobce nástroje. Nadměrná rychlost nebo nevhodný posuv mohou způsobit přehřátí, chvění a rychlé opotřebení.

• Řezná rychlost v [m/min] – obvodová rychlost povrchu obrobku v místě řezu.
• Otáčky n [min⁻¹] – počet otáček obrobku za minutu.
• Posuv na otáčku f [mm/ot] – o kolik se nástroj posune během jedné otáčky.
• Hloubka řezu ap [mm] – radiální tloušťka odebírané vrstvy.
• Posuvová rychlost vf [mm/min] – rychlost posuvu nástroje.

Otáčky se vypočítají ze vztahu n = (v × 1000) / (3,14 × D), kde D je průměr obrobku v mm. Posuvová rychlost vf = f × n.

Příklad: obrobek má průměr D = 50 mm a doporučenou řeznou rychlost v = 100 m/min. n = (100 × 1000) / (3,14 × 50) ≈ 637 min⁻¹. Při posuvu f = 0,2 mm/ot je vf = 0,2 × 637 = 127,4 mm/min. Na stroji zvolíme vhodný dostupný stupeň otáček, který nepřekročí bezpečné podmínky upnutí a nástroje.

Přibližný průřez třísky při podélném soustružení lze vyjádřit A ≈ ap × f. Chladicí a mazací prostředek se volí podle materiálu, nástroje a operace.`},
      {title:'Opotřebení nástroje a jakost povrchu',text:`Řezný nástroj se postupně opotřebovává. Hřbetní opotřebení vzniká třením o obrobenou plochu, kráter na čele souvisí s prouděním třísky a teplotou. Břit se může také vylomit, například při přerušovaném řezu, chvění nebo nedostatečně tuhém upnutí.

Tupý nebo poškozený nástroj zvyšuje řezné síly a teplotu, zhoršuje rozměr i povrch. Sledujte zvuk, chvění, tvar třísky a stav ostří. Nástroj včas vyměňte nebo naostřete; řezné podmínky upravujte podle doporučení pro daný nástroj a obrobek.

Chvění a vlnitý povrch často souvisejí s malou tuhostí sestavy, dlouhým vyložením obrobku nebo nástroje, vůlemi, tupým břitem nebo nevhodnými podmínkami. Pomůže zkrátit vyložení, použít oporu, zkontrolovat upnutí a stav stroje a zvolit vhodný nástroj a řezné podmínky.`},
      {title:'Postup práce, měření a kontrola',text:`Při plánování se nejprve prostuduje výkres, materiál a požadované tolerance. Zvolí se polotovar, způsob upnutí a sled operací. Při hrubování se ponechá přídavek pro dokončení; po obrábění se součást odjehlí a zkontroluje.

Pro kontrolu se používá posuvné měřítko pro základní rozměry, mikrometr pro přesnější měření průměrů a úchylkoměr například pro kontrolu házení či souososti. Závity se kontrolují závitovými měřidly. Před měřením, čištěním nebo odstraňováním třísek musí být stroj zastaven.

Rozměrové chyby mohou způsobit nesprávné upnutí či seřízení, průhyb obrobku, teplotní změna, opotřebení nástroje nebo chybná korekce. Otřepy vznikají na hranách a po dokončení se bezpečně odstraní. Dlouhé třísky se řeší nastavením nástroje a podmínek, nikoli ručním taháním za běhu stroje.`},
      {title:'Bezpečnost při soustružení a osnova odpovědi',text:`Před spuštěním zkontrolujte upnutí obrobku a nástroje, kryty a volný prostor. Klíč ze sklíčidla ihned odložte. Používejte ochranné brýle; dlouhé vlasy svažte a odložte šperky. Nenoste volný oděv ani rukavice v blízkosti rotujících částí. Rotujícího obrobku se nedotýkejte.

Měření, seřizování, výměnu nástroje, čištění a odstraňování třísek provádějte pouze po zastavení stroje. Třísky odstraňujte háčkem nebo kartáčem, ne rukou. Při závadě stroj zastavte a upozorněte učitele či obsluhu.

Osnova maturitní odpovědi: vysvětlete princip a pohyby; popište části soustruhu a způsoby upnutí; uveďte druhy nožů a geometrii břitu; popište hlavní operace; vysvětlete v, f, ap a výpočet otáček; doplňte kontrolu, opotřebení a bezpečnost.`}
    ];
    const svgData=s=>'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(s);
    notes[0].lead='Přehled konstrukčních materiálů pro strojírenství: jejich vlastnosti, zkoušení, použití a ochrana. Zahrnuje oceli a litiny, tepelné zpracování, neželezné kovy, plasty, keramiku i kompozity.';
    notes[0].blocks=[
      {title:'Rozdělení a volba technických materiálů',text:`Konstrukční materiál vybíráme podle funkce součásti a podmínek, ve kterých bude pracovat. Musí vyhovovat zatížení, prostředí, výrobní technologii, požadované životnosti, bezpečnosti i ceně. Stejnou součást lze často vyrobit z více materiálů; liší se hmotností, pevností, odolností, možnostmi výroby i náklady.

Základní skupiny:
• Kovové materiály – železné kovy (oceli a litiny) a neželezné kovy (například hliník, měď, hořčík a titan).
• Nekovové materiály – plasty, technická keramika a sklo.
• Kompozity – kombinace matrice a výztuže, jejichž vlastnosti lze navrhnout podle použití.

Vlastnosti materiálů dělíme na fyzikální (hustota, teplota tavení, tepelná a elektrická vodivost, magnetické vlastnosti), mechanické (pevnost, tvrdost, pružnost, plasticita, houževnatost, únava a odolnost proti opotřebení), chemické (odolnost proti korozi a chemikáliím) a technologické (obrobitelnost, slévatelnost, tvářitelnost, svařitelnost, kalitelnost a pájitelnost). Při výběru je třeba hodnotit celý soubor vlastností, ne pouze pevnost.`},
      {title:'Mechanické vlastnosti a jejich zkoušení',text:`Mechanické vlastnosti popisují chování materiálu při působení sil. Závisí na složení, struktuře, teplotě, rychlosti zatěžování a způsobu zkoušky. Součást se navrhuje na dovolené zatížení s bezpečností, ne pouze podle jedné hodnoty pevnosti.

• Pevnost – schopnost odolávat zatížení bez porušení; sleduje se například v tahu, tlaku, ohybu či smyku.
• Tvrdost – odolnost povrchu proti vnikání tvrdšího tělesa; souvisí s odolností proti opotřebení.
• Pružnost – po odlehčení se materiál vrací do původního tvaru. Plasticita znamená trvalou deformaci bez porušení.
• Houževnatost – schopnost pohltit energii a odolávat lomu, zvláště při rázu. Křehký materiál se poruší s malou plastickou deformací.
• Únava – postupné poškozování při opakovaném nebo proměnném zatěžování.

Při tahové zkoušce se zkušební tyč plynule zatěžuje až do přetržení a sleduje se síla a prodloužení. Zkouškou se stanovuje například mez kluzu, pevnost v tahu a tažnost. Tvrdost se zkouší metodami Brinell, Rockwell nebo Vickers podle velikosti vtisku. Rázová zkouška stanovuje vrubovou houževnatost kyvadlovým kladivem; únavová zkouška sleduje opakované zatěžování. Technologické zkoušky mohou zahrnovat ohyb, pěchování nebo svařitelnost.`},
      {title:'Železné kovy: oceli a litiny',text:`Železné kovy mají jako základ železo. Jejich vlastnosti upravuje obsah uhlíku, další legující prvky a tepelné zpracování. Oceli se zpravidla tváří a obrábějí, litiny mají vyšší obsah uhlíku a obvykle se dobře odlévají.

• Nelegované konstrukční oceli mají dobrou pevnost a tvárnost, jsou běžně dostupné a podle jakosti svařitelné. Používají se na nosníky, rámy, hřídele a plechy.
• Uhlíkové nástrojové oceli lze tepelným zpracováním vytvrdit; vyrábějí se z nich ruční nástroje, razníky a jednodušší řezné nástroje.
• Legované oceli obsahují prvky upravující pevnost, prokalitelnost, houževnatost nebo korozní odolnost. Používají se například na ozubená kola, pružiny a namáhané součásti.
• Korozivzdorné oceli obsahují legující prvky, zejména chrom. Odolnost závisí na přesném složení a prostředí; příkladem je ocel 1.4301 (X5CrNi18-10).
• Šedá litina má grafit ve formě lupínků, dobře tlumí vibrace a obrábí se, ale je méně houževnatá. Používá se na lože strojů a skříně.
• Tvárná litina má grafit v kuličkách a vyšší pevnost i houževnatost než šedá litina; využívá se na namáhané odlitky a hřídele.

Označení materiálu může vyjadřovat použití, mechanické vlastnosti, chemické složení nebo pořadové číslo. Význam značky ověřujeme podle výkresu, normy a dokumentace dodávky.`},
      {title:'Tepelné a povrchové zpracování',text:`Tepelné zpracování mění strukturu a vlastnosti řízeným ohřevem, výdrží na teplotě a ochlazováním. Výsledek závisí na materiálu, průřezu součásti a průběhu procesu. Tvrdost se posuzuje společně s houževnatostí a rozměrovou stálostí.

• Žíhání – ohřev a řízené ochlazení; může materiál změkčit, snížit vnitřní pnutí nebo upravit strukturu.
• Normalizační žíhání – u vhodných ocelí sjednocuje strukturu a zjemňuje zrno; ochlazuje se na vzduchu.
• Kalení – ohřev do kalicí oblasti a rychlé ochlazení; zvyšuje tvrdost a pevnost, ale zpravidla také křehkost a vnitřní pnutí.
• Popouštění – ohřev zakalené oceli pod kritickou teplotu; snižuje křehkost a upravuje poměr tvrdosti a houževnatosti.
• Zušlechťování – kalení a následné vysoké popouštění pro vhodnou kombinaci pevnosti a houževnatosti.

Indukční nebo plamenové kalení vytváří tvrdý povrch a houževnatější jádro. Cementování obohacuje povrch uhlíkem a následuje kalení. Nitridování obohacuje povrch dusíkem a vytváří tvrdou vrstvu s malými deformacemi. Zinkování, niklování, chromování, lakování a práškové lakování upravují povrch nebo jej chrání. Při tepelném zpracování mohou vzniknout deformace, trhliny a zbytková pnutí, proto následuje kontrola rozměru i tvrdosti.`},
      {title:'Neželezné kovy a slitiny',text:`Neželezné kovy nemají jako základní prvek železo. Používají se pro nízkou hmotnost, vodivost, korozní odolnost, vzhled nebo jiné specifické vlastnosti. Čisté kovy se pro strojní součásti často legují. Slitina je kovový materiál z více prvků, z nichž alespoň jeden je kov; legováním lze měnit pevnost, tvrdost, korozní odolnost, slévatelnost i obrobitelnost.

• Hliník a jeho slitiny mají nízkou hustotu a dobrou tepelnou i elektrickou vodivost; používají se na kryty, profily, odlitky a dopravní techniku.
• Měď výborně vede teplo a elektřinu. Mosaz je slitina mědi a zinku, bronz obvykle mědi a cínu. Použití: vodiče, výměníky, armatury, pouzdra a kluzná ložiska.
• Hořčík a jeho slitiny mají velmi nízkou hustotu; při výrobě vyžadují pozornost kvůli zpracování a ochraně povrchu.
• Titan má vysoký poměr pevnosti k hmotnosti a dobrou korozní odolnost, ale jeho výroba bývá náročnější. Používá se v letectví, chemických zařízeních a zdravotnictví.
• Zinek se dobře odlévá a slouží také jako ochranný povlak oceli. Niklové slitiny odolávají vyšším teplotám a některým korozním prostředím.

Vlastnosti slitiny závisejí také na její struktuře a technologickém zpracování.`},
      {title:'Plasty, keramika, sklo a kompozity',text:`• Termoplasty při zahřátí měknou a lze je znovu tvarovat; používají se na obaly, potrubí a kryty. Patří sem například PE, PP, PVC a PA.
• Reaktoplasty po vytvrzení běžným zahřátím znovu netají; bývají tuhé a rozměrově stálé. Využívají se na elektroizolační díly, lepidla a lamináty.
• Elastomery snesou velkou vratnou deformaci a jsou pružné; příklady použití jsou těsnění, hadice a pneumatiky.
• Technická keramika má vysokou tvrdost, tepelnou odolnost a odolnost proti opotřebení, její křehkost však omezuje použití při rázech. Vyrábějí se z ní řezné destičky, izolátory a žáruvzdorné díly.
• Sklo je tvrdé, křehké a chemicky odolné; průhlednost závisí na složení a výrobě.
• Kompozit spojuje matrici a výztuž. U laminátu polymerní pryskyřice drží skelná nebo uhlíková vlákna a přenáší zatížení; vlákna zvyšují pevnost a tuhost hlavně ve směru uložení. Kompozit může být lehký a pevný, ale jeho opravy a recyklace bývají složitější.

Materiál součásti, například potrubí, se vybírá podle teploty, tlaku, chemické odolnosti, montáže a ceny; rozhodující není jen název skupiny materiálu.`},
      {title:'Koroze, ochrana materiálu a jeho výběr',text:`Koroze je samovolné znehodnocování materiálu vlivem okolního prostředí. U kovů probíhá chemicky nebo elektrochemicky. Rychlost ovlivňuje vlhkost, teplota, soli, chemické látky, konstrukční štěrbiny a kontakt různých kovů.

Způsoby ochrany:
• zvolit korozivzdornou ocel, vhodnou slitinu, polymer nebo keramiku;
• upravit konstrukci tak, aby nezadržovala vodu, omezit štěrbiny a zajistit odvodnění;
• oddělit povrch nátěrem, lakem, práškovým nebo plastovým povlakem;
• použít kovový povlak, například zinkování, niklování či chromování;
• u vhodných potrubí a nádrží použít katodickou ochranu;
• ochranu pravidelně kontrolovat, čistit, obnovovat a poškozené díly včas měnit.

Při výběru součásti určete zatížení (tah, tlak, ohyb, krut, ráz, únava a opotřebení), prostředí (vlhkost, teplota, chemikálie), požadované rozměry, toleranci, životnost, hmotnost a bezpečnost. Ověřte vhodnou výrobu, například odlévání, tváření, svařování, obrábění nebo vstřikování. Porovnejte také cenu, dostupnost, údržbu a recyklaci. Materiál musí jít vyrobit, bezpečně používat, kontrolovat a případně opravit.`},
      {title:'Maturitní osnova a kontrolní otázky',text:`Při ústní odpovědi postupujte od rozdělení materiálů k jejich vlastnostem a použití. Potom popište zkoušení, oceli a litiny, tepelné zpracování, neželezné kovy, plasty, keramiku a kompozity. Odpověď zakončete korozí, ochranou a zásadami výběru materiálu.

Kontrolní otázky:
• Jaké jsou skupiny vlastností materiálů a co vyjadřují?
• Jak probíhá tahová zkouška a které vlastnosti z ní určíme?
• Jaký je rozdíl mezi ocelí a litinou a k čemu se používají?
• Co je kalení, popouštění a zušlechťování?
• Uveďte neželezné kovy a jejich typické použití. Čím se liší mosaz a bronz?
• Co je kompozit a jakou funkci má matrice a výztuž?
• Jak vzniká koroze a jak lze materiál chránit?
• Podle čeho vyberete materiál konkrétní součásti?

Hlavní myšlenka: materiál se vybírá podle kombinace funkce, zatížení, prostředí, výroby, životnosti, bezpečnosti a ceny; samotná pevnost nestačí.`}
    ];
    notes[17].lead='Přehled teorie třískového obrábění: jak vzniká tříska, co ovlivňuje řezný proces a jak spolu souvisejí řezné podmínky, nástroj, síly, teplo, opotřebení a jakost povrchu.';
    notes[17].blocks=[
      {title:'Podstata a rozdělení strojního obrábění',text:`Strojní obrábění je výrobní proces, při kterém se z polotovaru odebírá materiál, aby součást získala předepsaný tvar, rozměry a jakost povrchu. Při třískovém obrábění vniká břit nástroje do materiálu, vrstva se deformuje a oddělí ve formě třísky. Na obrobku vzniká nová plocha.

Obráběcí metody se dělí podle geometrie břitu:
• Definovaná geometrie – břit má rozpoznatelný tvar; patří sem soustružení, frézování, vrtání, vystružování, hoblování a protahování.
• Neurčitá geometrie – materiál odebírá mnoho drobných brusných zrn; například broušení, honování a lapování.
• Nekonvenční metody – materiál se odebírá elektrickou, tepelnou, chemickou nebo mechanickou energií; například EDM, laserem, vodním paprskem nebo elektrochemicky.

Polotovar je výchozí materiál, například tyč, výkovek nebo odlitek. Přídavek na obrábění je vrstva ponechaná pro dosažení konečných rozměrů a povrchu.`},
      {title:'Řezný klín, břit a geometrie nástroje',text:`Řezný klín proniká do obrobku a odděluje třísku. Je tvořen čelem, po kterém tříska odchází, a hřbetem, který směřuje k nově vytvořené ploše. Jejich průsečík tvoří ostří.

• Čelo ovlivňuje deformaci a odvod třísky.
• Hřbetní úhel α vytváří vůli mezi hřbetem a obrobenou plochou, čímž omezuje tření.
• Úhel břitu β určuje pevnost klínu: větší úhel obvykle znamená pevnější břit, který však hůře vniká do materiálu.
• Čelní úhel γ ovlivňuje odchod třísky, řezné síly i pevnost břitu. Volí se podle materiálu a operace.

V základním ortogonálním řezu platí zjednodušený vztah α + β + γ = 90°. Skutečné označování úhlů závisí na použité soustavě a poloze břitu. Geometrii je nutné volit jako celek s ohledem na materiál, zatížení a požadovanou jakost.`},
      {title:'Vznik a druhy třísek',text:`Materiál před břitem se stlačuje a plasticky deformuje. Deformace se soustředí do oblasti smyku, kde se materiál oddělí. Tříska potom klouže po čele nástroje, třením se zahřívá a může se stáčet nebo lámat. Velká část práce při obrábění se mění na teplo.

• Plynulá tříska tvoří souvislý pás a vzniká často při obrábění houževnatých materiálů a stabilním řezu. Může se namotávat a ohrožovat obsluhu; její tvar pomáhá řídit utvařeč.
• Článkovitá tříska se odděluje v navazujících segmentech, například při vyšších rychlostech nebo u obtížně obrobitelných materiálů. Zatížení může kolísat a zvyšovat chvění.
• Elementární neboli trhaná tříska se skládá z krátkých částic. Bývá typická pro křehké materiály nebo nevhodné podmínky; odvod je snadný, povrch však může být horší.

Tvar třísky závisí na materiálu obrobku, řezné rychlosti, posuvu, hloubce řezu, geometrii břitu, mazání a tuhosti stroje. Třísky mohou být velmi ostré a horké, proto se nikdy neodstraňují rukou.`},
      {title:'Řezné síly, výkon, teplo a tuhost',text:`Při řezu působí mezi břitem a obrobkem síly, které zatěžují nástroj, obrobek i stroj. Ve zjednodušeném modelu rozlišujeme hlavní řeznou sílu Fc ve směru hlavního pohybu, posuvovou sílu Ff ve směru posuvu a pasivní sílu Fp přibližně kolmo k obráběné ploše. Pasivní síla může vyvolat průhyb a rozměrovou odchylku.

Přibližný výkon při řezání je P ≈ Fc × vc / 60 000, pokud je Fc v newtonech a vc v m/min; výsledek vychází v kW. Potřebný výkon stroje musí počítat také se ztrátami pohonu.

Teplo vzniká hlavně při primární deformaci materiálu, tření třísky o čelo a tření hřbetu o povrch. Odvádí se třískou, nástrojem a obrobkem. Nadměrná teplota urychluje opotřebení a může způsobit rozměrové změny nebo změnu povrchové vrstvy.

Tuhost soustavy stroj–nástroj–obrobek–upnutí je důležitá pro stabilní řez. Malá tuhost způsobuje průhyb a vibrace, které zhoršují rozměr i povrch. Pomáhá pevné upnutí, krátké vyložení a ostrý nástroj.`},
      {title:'Řezné podmínky a výpočet otáček',text:`Základními řeznými podmínkami jsou řezná rychlost vc [m/min], otáčky n [min⁻¹], posuv f [mm/ot] nebo u frézování posuv na zub fz, posuvová rychlost vf [mm/min] a hloubka řezu ap [mm]. Volí se podle materiálu obrobku a nástroje, tuhosti, požadované přesnosti a povrchu i doporučení výrobce.

Pro soustružení a vrtání platí n = (1000 × vc) / (π × D), kde D je průměr v mm. Při použití π ≈ 3,14 například pro D = 40 mm a vc = 120 m/min vychází n ≈ 955 min⁻¹. Na stroji se zvolí nejbližší vhodný stupeň s ohledem na jeho možnosti a bezpečné upnutí.

Při soustružení je posuvová rychlost vf = f × n. Při frézování vf = fz × z × n, kde z je počet zubů. Vyšší řezná rychlost zpravidla zvyšuje produktivitu, ale také teplotu a opotřebení. Větší posuv obvykle zhoršuje drsnost a větší hloubka řezu zvyšuje průřez třísky i řezné síly.

Hrubování rychle odebírá větší množství materiálu a ponechává přídavek. Polodokončování připraví rozměr pro finální operaci. Dokončování s menším přídavkem a stabilními podmínkami dosahuje konečné tolerance a povrchu.`},
      {title:'Řezné materiály a opotřebení nástroje',text:`Řezný materiál má být tvrdý a odolný proti opotřebení i při pracovní teplotě, ale také dostatečně pevný a houževnatý. Univerzálně nejlepší nástroj neexistuje; výběr závisí na obrobku, operaci a stabilitě řezu.

• Nástrojová ocel a HSS jsou houževnaté, dobře brousitelné a běžné například u vrtáků a závitníků.
• Slinutý karbid je tvrdý a odolává vyšším teplotám; často se používá ve vyměnitelných destičkách.
• Cermet se hodí zejména k dokončování některých ocelí.
• Keramika je tvrdá a žáruvzdorná, ale křehčí; vyžaduje stabilní podmínky.
• CBN se používá například pro obrábění kalených ocelí.
• Diamant a PCD jsou velmi tvrdé a vhodné pro neželezné kovy a abrazivní nekovové materiály; nejsou běžnou volbou pro obrábění ocelí při vysoké teplotě.

Opotřebení může být hřbetní (oděr o obrobenou plochu), kráterové (prohlubeň na čele od kontaktu s třískou), vylamování břitu, plastická deformace při vysoké teplotě nebo nárůstek materiálu na ostří. Nástroj vyměňujeme či přeostříme, když opotřebení zhorší rozměr, povrch, síly nebo bezpečnost procesu. Vyšší řezná rychlost obvykle životnost nástroje výrazně zkracuje.`},
      {title:'Jakost povrchu, kapaliny a obrobitelnost',text:`Kromě rozměru se hodnotí tvarová přesnost, drsnost a stav povrchové vrstvy. Drsnost závisí na posuvu, tvaru špičky, vibracích, materiálu a ostrosti břitu. Větší posuv obvykle zanechává výraznější stopy. Tupý nástroj zvyšuje síly, tření, otřepy a zhoršuje povrch. Nedostatečná tuhost vede k chvění a vlnitosti; teplo mění rozměry.

Chladicí a mazací kapalina může odvádět teplo, snižovat tření, pomáhat s odvodem třísek a chránit před korozí. Lze obrábět také nasucho nebo s minimálním množstvím maziva. Způsob chlazení musí odpovídat materiálu a doporučení výrobce; nevhodné chlazení může způsobit tepelný šok.

Obrobitelnost vyjadřuje, jak snadno lze materiál obrábět při požadované jakosti a hospodárnosti. Posuzuje se například dosažitelnou řeznou rychlostí při určité životnosti nástroje, velikostí sil, tvorbou třísky a kvalitou povrchu. Závisí na materiálu, nástroji i podmínkách procesu.`},
      {title:'Volba technologie, bezpečnost a maturitní osnova',text:`Při volbě technologie zvažte materiál a tvrdost obrobku, požadovaný tvar a tolerance, velikost přídavku, vhodný nástroj, řezné podmínky, tuhost upnutí, požadovaný povrch, čas i náklady.

Bezpečnost: třísky mohou být ostré a horké, proto je nikdy neodstraňujte rukou. U rotujících částí nepoužívejte volný oděv, šperky ani rukavice, které se mohou zachytit. Měření a výměnu nástroje provádějte bezpečně při zastaveném stroji.

Osnova ústní odpovědi: 1. Definujte strojní a třískové obrábění a uveďte rozdělení metod. 2. Popište řezný klín a úhly α, β, γ. 3. Vysvětlete vznik třísky a její druhy. 4. Uveďte řezné síly, výkon a vznik tepla. 5. Vysvětlete vc, n, f, vf a ap včetně výpočtu otáček. 6. Porovnejte řezné materiály a druhy opotřebení. 7. Doplňte vliv na jakost, chlazení, obrobitelnost a bezpečnost.

Hlavní souvislost: vyšší produktivita musí zůstat slučitelná s životností nástroje, stabilitou procesu a požadovanou jakostí součásti.`}
    ];
    notes[12].figures={
      1:[{src:svgData(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 390"><rect width="1000" height="390" rx="18" fill="#11130f" stroke="#3b4036"/><text x="40" y="42" fill="#a7c98f" font-family="Arial,sans-serif" font-size="22" font-weight="700">TAHOVÁ ZKOUŠKA · SCHEMATICKÝ PRŮBĚH</text><path d="M125 305V85M125 305H900" fill="none" stroke="#d7d8cb" stroke-width="3"/><text x="48" y="105" fill="#e8e7de" font-family="Arial,sans-serif" font-size="16">napětí σ</text><text x="810" y="340" fill="#e8e7de" font-family="Arial,sans-serif" font-size="16">prodloužení ε</text><path d="M125 305L270 154C305 122 340 119 380 133C485 172 560 209 650 208C735 207 803 182 860 160" fill="none" stroke="#78b8d8" stroke-width="7" stroke-linecap="round"/><path d="M270 154V305" stroke="#e4a36e" stroke-width="3" stroke-dasharray="8 7"/><circle cx="270" cy="154" r="7" fill="#e4a36e"/><text x="218" y="133" fill="#e4a36e" font-family="Arial,sans-serif" font-size="16">mez kluzu Re / Rp0,2</text><text x="450" y="115" fill="#a7c98f" font-family="Arial,sans-serif" font-size="16">pevnost v tahu Rm</text><path d="M510 120L385 136" stroke="#a7c98f" stroke-width="2"/><text x="40" y="372" fill="#aaa99f" font-family="Arial,sans-serif" font-size="14">Tvar křivky je orientační; výsledek závisí na materiálu a podmínkách zkoušky.</text></svg>`),alt:'Schematický diagram tahové zkoušky s napětím, prodloužením, mezí kluzu a pevností v tahu',caption:'Tahová zkouška: ze síly a prodloužení se vyhodnocuje průběh deformace a pevnost.',wide:true}],
      2:[{src:svgData(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 380"><rect width="1000" height="380" rx="18" fill="#11130f" stroke="#3b4036"/><text x="500" y="42" text-anchor="middle" fill="#a7c98f" font-family="Arial,sans-serif" font-size="22" font-weight="700">TŘI ZÁKLADNÍ METODY ZKOUŠKY TVRDOSTI</text><g font-family="Arial,sans-serif" text-anchor="middle"><g transform="translate(55 78)"><rect width="270" height="235" rx="16" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="135" y="35" fill="#c9e4aa" font-size="19" font-weight="700">BRINELL · HBW</text><path d="M85 105h100" stroke="#d7d8cb" stroke-width="4"/><circle cx="135" cy="76" r="28" fill="#6f91a2" stroke="#e8e7de" stroke-width="3"/><path d="M135 104v33" stroke="#e4a36e" stroke-width="5"/><rect x="65" y="137" width="140" height="42" rx="5" fill="#526447"/><ellipse cx="135" cy="139" rx="20" ry="5" fill="#11130f"/><text x="135" y="208" fill="#e8e7de" font-size="14">měří se průměr vtisku</text></g><g transform="translate(365 78)"><rect width="270" height="235" rx="16" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="135" y="35" fill="#c9e4aa" font-size="19" font-weight="700">ROCKWELL · HR</text><path d="M85 105h100" stroke="#d7d8cb" stroke-width="4"/><path d="M135 60l28 32-28 32-28-32z" fill="#a7c98f" stroke="#e8e7de" stroke-width="3"/><path d="M135 124v16" stroke="#e4a36e" stroke-width="5"/><rect x="65" y="140" width="140" height="39" rx="5" fill="#526447"/><path d="M135 140v11" stroke="#11130f" stroke-width="4"/><text x="135" y="208" fill="#e8e7de" font-size="14">měří se hloubka vtisku</text></g><g transform="translate(675 78)"><rect width="270" height="235" rx="16" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="135" y="35" fill="#c9e4aa" font-size="19" font-weight="700">VICKERS · HV</text><path d="M85 105h100" stroke="#d7d8cb" stroke-width="4"/><path d="M135 62l32 40-32 40-32-40z" fill="#a7c98f" stroke="#e8e7de" stroke-width="3"/><path d="M135 142v-4" stroke="#e4a36e" stroke-width="5"/><rect x="65" y="140" width="140" height="39" rx="5" fill="#526447"/><path d="M119 140l16 9 16-9" fill="none" stroke="#11130f" stroke-width="3"/><text x="135" y="208" fill="#e8e7de" font-size="14">měří se úhlopříčky vtisku</text></g></g><text x="500" y="350" text-anchor="middle" fill="#aaa99f" font-family="Arial,sans-serif" font-size="14">Volba metody a zatížení závisí na materiálu, tloušťce a povrchu vzorku.</text></svg>`),alt:'Porovnání metod tvrdosti Brinell, Rockwell a Vickers včetně tvaru vtisku a veličiny, která se měří',caption:'Brinell hodnotí průměr vtisku, Rockwell jeho hloubku a Vickers úhlopříčky.',wide:true}]
    };
    notes[18].figures={
      2:[{src:svgData(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1100 360"><rect width="1100" height="360" rx="18" fill="#11130f" stroke="#3b4036"/><text x="550" y="42" text-anchor="middle" fill="#a7c98f" font-family="Arial,sans-serif" font-size="22" font-weight="700">OD POŽADAVKU K HOTOVÉMU VÝROBKU</text><g font-family="Arial,sans-serif" text-anchor="middle"><g><rect x="35" y="105" width="185" height="145" rx="14" fill="#182016" stroke="#a7c98f" stroke-width="2"/><text x="127" y="148" fill="#c9e4aa" font-size="17" font-weight="700">1 · VÝKRES</text><text x="127" y="180" fill="#e8e7de" font-size="14">rozměry · tolerance</text><text x="127" y="203" fill="#e8e7de" font-size="14">materiál · jakost</text></g><g><rect x="250" y="105" width="185" height="145" rx="14" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="342" y="148" fill="#c9e4aa" font-size="17" font-weight="700">2 · POLOTOVAR</text><text x="342" y="180" fill="#e8e7de" font-size="14">tyč · plech · výkovek</text><text x="342" y="203" fill="#e8e7de" font-size="14">přídavek na obrábění</text></g><g><rect x="465" y="105" width="185" height="145" rx="14" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="557" y="148" fill="#c9e4aa" font-size="17" font-weight="700">3 · OPERACE</text><text x="557" y="180" fill="#e8e7de" font-size="14">stroje · upnutí</text><text x="557" y="203" fill="#e8e7de" font-size="14">nástroje · pořadí</text></g><g><rect x="680" y="105" width="185" height="145" rx="14" fill="#171c14" stroke="#495343" stroke-width="2"/><text x="772" y="148" fill="#c9e4aa" font-size="17" font-weight="700">4 · KONTROLA</text><text x="772" y="180" fill="#e8e7de" font-size="14">měření · tolerance</text><text x="772" y="203" fill="#e8e7de" font-size="14">záznam výsledku</text></g><g><rect x="895" y="105" width="170" height="145" rx="14" fill="#182016" stroke="#a7c98f" stroke-width="2"/><text x="980" y="148" fill="#c9e4aa" font-size="17" font-weight="700">5 · VÝROBEK</text><text x="980" y="180" fill="#e8e7de" font-size="14">splněné požadavky</text><text x="980" y="203" fill="#e8e7de" font-size="14">bezpečně a opakovaně</text></g></g><g fill="none" stroke="#a7c98f" stroke-width="4"><path d="M220 177h25m-9-9 9 9-9 9M435 177h25m-9-9 9 9-9 9M650 177h25m-9-9 9 9-9 9M865 177h25m-9-9 9 9-9 9"/></g><text x="550" y="310" text-anchor="middle" fill="#aaa99f" font-family="Arial,sans-serif" font-size="15">Postup spojuje požadavky výkresu, proveditelné operace a průběžnou kontrolu kvality.</text></svg>`),alt:'Pět kroků výrobního postupu: výkres, volba polotovaru, operace, kontrola a hotový výrobek',caption:'Výrobní postup převádí požadavky výkresu do opakovatelného sledu operací a kontrol.',wide:true}]
    };
    notes[0].figures={
      0:[{src:svgData(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 540"><rect width="1000" height="540" rx="18" fill="#11130f" stroke="#3b4036"/><text x="500" y="30" text-anchor="middle" fill="#a7c98f" font-family="Arial,sans-serif" font-size="19" font-weight="700">STROM ROZDĚLENÍ TECHNICKÝCH MATERIÁLŮ</text><g fill="none" stroke="#6e8560" stroke-width="3"><path d="M500 103v28H165v20M500 131v20M500 131h335v20"/><path d="M165 225v28M500 225v28"/><path d=""/></g><g fill="#182016" stroke="#a7c98f" stroke-width="2"><rect x="350" y="48" width="300" height="55" rx="12"/><rect x="35" y="151" width="260" height="74" rx="12"/><rect x="370" y="151" width="260" height="74" rx="12"/><rect x="705" y="151" width="260" height="74" rx="12"/></g><g text-anchor="middle" font-family="Arial,sans-serif"><text x="500" y="82" fill="#e8e7de" font-size="18" font-weight="700">TECHNICKÉ MATERIÁLY</text><text x="165" y="181" fill="#c9e4aa" font-size="18" font-weight="700">KOVOVÉ</text><text x="165" y="205" fill="#e8e7de" font-size="13">podle obsahu uhlíku a složení</text><text x="500" y="181" fill="#c9e4aa" font-size="18" font-weight="700">NEKOVOVÉ</text><text x="500" y="205" fill="#e8e7de" font-size="13">organické a anorganické</text><text x="835" y="181" fill="#c9e4aa" font-size="18" font-weight="700">KOMPOZITNÍ</text><text x="835" y="205" fill="#e8e7de" font-size="13">matrice + výztuž</text></g><g fill="#171c14" stroke="#495343" stroke-width="2"><rect x="30" y="281" width="270" height="68" rx="10"/><rect x="30" y="365" width="270" height="68" rx="10"/><rect x="365" y="281" width="270" height="68" rx="10"/><rect x="365" y="365" width="270" height="68" rx="10"/></g><g text-anchor="middle" font-family="Arial,sans-serif"><text x="165" y="307" fill="#c9e4aa" font-size="15" font-weight="700">ŽELEZNÉ</text><text x="165" y="330" fill="#e8e7de" font-size="14">oceli · litiny</text><text x="165" y="391" fill="#c9e4aa" font-size="15" font-weight="700">NEŽELEZNÉ</text><text x="165" y="414" fill="#e8e7de" font-size="14">Al · Cu · Mg · Ti · Zn · Ni</text><text x="500" y="307" fill="#c9e4aa" font-size="15" font-weight="700">ORGANICKÉ</text><text x="500" y="330" fill="#e8e7de" font-size="14">plasty · pryže · dřevo</text><text x="500" y="391" fill="#c9e4aa" font-size="15" font-weight="700">ANORGANICKÉ</text><text x="500" y="414" fill="#e8e7de" font-size="14">sklo · keramika</text></g></svg>`),alt:'Rozšířený strom technických materiálů: kovové na železné a neželezné, nekovové na organické a anorganické',caption:'Rozdělení kovových a nekovových materiálů; kompozity tvoří samostatnou skupinu.',wide:true}],
      1:[{src:svgData(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 390"><rect width="1000" height="390" rx="18" fill="#11130f" stroke="#3b4036"/><text x="40" y="46" fill="#a7c98f" font-family="Arial,sans-serif" font-size="23" font-weight="700">TAHOVÁ ZKOUŠKA – SCHEMATICKÝ DIAGRAM</text><path d="M135 310V95M135 310H890" fill="none" stroke="#d7d8cb" stroke-width="3"/><text x="80" y="115" fill="#e8e7de" font-family="Arial,sans-serif" font-size="16">napětí σ</text><text x="814" y="345" fill="#e8e7de" font-family="Arial,sans-serif" font-size="16">prodloužení ε</text><path d="M135 310L285 165C320 130 355 125 390 137C510 178 570 222 665 218C745 215 805 196 860 176" fill="none" stroke="#78b8d8" stroke-width="7" stroke-linecap="round"/><path d="M285 165V310" stroke="#e4a36e" stroke-width="3" stroke-dasharray="9 8"/><circle cx="285" cy="165" r="8" fill="#e4a36e"/><text x="245" y="140" fill="#e4a36e" font-family="Arial,sans-serif" font-size="16">mez kluzu</text><text x="410" y="116" fill="#a7c98f" font-family="Arial,sans-serif" font-size="16">pevnost v tahu</text><path d="M410 123L390 137" stroke="#a7c98f" stroke-width="2"/><text x="40" y="372" fill="#aaa99f" font-family="Arial,sans-serif" font-size="14">Tvar křivky je orientační; skutečný průběh závisí na materiálu a zkoušce.</text></svg>`),alt:'Schematický diagram tahové zkoušky s vyznačeným napětím, prodloužením, mezí kluzu a pevností v tahu',caption:'Při tahové zkoušce se sleduje vztah mezi zatížením a prodloužením až do přetržení.',wide:true}]
    };

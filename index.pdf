n');bottom.textContent=block.formula.denominator;frac.append(top,bottom);p.append(frac,document.createTextNode(parts[1]))}}section.append(h,p);const figures=n.figures&&n.figures[j]||[];if(figures.length){const gallery=document.createElement('div');gallery.className='study-figures';figures.forEach(item=>{const figureEl=document.createElement('figure');figureEl.className='study-figure';figureEl.classList.toggle('wide',!!item.wide);figureEl.classList.toggle('focus-figure',active===0&&j===0&&item.alt.startsWith('Rozšířený strom'));const imageButton=document.createElement('button');imageButton.type='button';imageButton.className='study-image-open';imageButton.setAttribute('aria-label','Zvětšit obrázek: '+item.caption);imageButton.addEventListener('click',()=>openImageViewer(item,imageButton));const imageEl=document.createElement('img');imageEl.src=item.src;imageEl.alt=item.alt;imageEl.loading='lazy';imageButton.append(imageEl);figureEl.append(imageButton);const captionEl=document.createElement('figcaption');captionEl.textContent=item.caption;figureEl.append(captionEl);gallery.append(figureEl)});section.append(gallery)}detail.append(section)});detail.append(buildStudyEstimate(n));document.getElementById('modalScroll').scrollTop=0}
    function setTestExitButton(isTest){const button=document.getElementById('closeBtn');button.textContent='×';button.setAttribute('aria-label',isTest?'Zavřít test':'Zavřít okno')}
    function restoreQuestionSearch(){const header=document.querySelector('.modal-head'),actions=document.querySelector('.modal-close-actions');if(header&&actions&&questionSearchBox&&!header.contains(questionSearchBox))header.insertBefore(questionSearchBox,actions)}
    function showModalRenderError(error){detail.replaceChildren();const message=document.createElement('p');message.className='detail-lead';message.textContent='Obsah se nepodařilo načíst: '+(error&&error.message?error.message:String(error));detail.append(message);console.error('Chyba při vykreslení obsahu záložky:',error)}
    function resetTestState(){const wasTest=testTopicOpen||!!detail.querySelector('.quiz-item')||!!detail.querySelector('#quizProgress');testTopicOpen=false;currentTestTopic=null;currentTestQuestions=[];submittedAnswers=[];restoreQuestionSearch();if(wasTest)detail.replaceChildren();const search=document.querySelector('.question-search');if(search)search.style.display='';const previous=document.getElementById('prevBtn'),next=document.getElementById('nextBtn');if(previous)previous.hidden=false;if(next)next.hidden=false}
    function close(){overlay.classList.remove('open');document.body.style.overflow='';testTopicOpen=false;currentTestTopic=null;currentTestQuestions=[];submittedAnswers=[];restoreQuestionSearch();setTestExitButton(false);const search=document.querySelector('.question-search');if(search)search.style.display='';const previous=document.getElementById('prevBtn'),next=document.getElementById('nextBtn');if(previous)previous.hidden=false;if(next)next.hidden=false;if(lastFocus&&lastFocus.isConnected&&typeof lastFocus.focus==='function')lastFocus.focus()}
    const searchInput=document.getElementById('searchInput'),searchResults=document.getElementById('searchResults');
    const normalize=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('cs');
    const conversation=[];const searchHistory=[];const questionOverviewTitle=document.querySelector('.toolbar .section-title');const defaultOverviewTitle=questionOverviewTitle.textContent;function getAuthorMatches(query){const terms=normalize(query).split(/[^a-z0-9]+/).filter(Boolean);if(!terms.length||terms.some(term=>term.length<3))return[];return Object.entries(topicAuthors).map(([id,name])=>({i:Number(id)-1,title:notes[Number(id)-1].title,author:name})).filter(item=>{const words=normalize(item.author).split(/[^a-z0-9]+/).filter(Boolean);return terms.every(term=>words.some(word=>word.includes(term)||term.includes(word)))})}function filterCardsByAuthor(results){const ids=new Set(results.map(r=>r.i));Array.from(grid.children).forEach((item,index)=>{item.style.display=ids.has(index)?'':'none'});questionOverviewTitle.textContent='Záložky autora: '+results[0].author+' ('+results.length+')'}function clearAuthorCardFilter(){Array.from(grid.children).forEach(item=>{item.style.display=''});questionOverviewTitle.textContent=defaultOverviewTitle}

    function ask(){
      const question=searchInput.value.trim();if(!question)return;searchHistory.unshift(question);if(searchHistory.length>3)searchHistory.length=3;
      const authorResults=getAuthorMatches(question);if(authorResults.length){filterCardsByAuthor(authorResults);searchResults.classList.remove('show','search-history-list');return}
      searchInput.value='';clearAuthorCardFilter();const stop=new Set(['co','je','jsou','to','se','na','do','v','ve','z','ze','a','i','o','u','s','k','ke','jak','jaky','jaka','jake','mi','me','pro','podle','ktera','ktery','ktere','muzes','vysvetli','popis','rekni','prosím','prosim']);const terms=normalize(question).split(/[^a-z0-9]+/).filter(t=>t.length>2&&!stop.has(t));if(!terms.length){searchResults.innerHTML='';const empty=document.createElement('div');empty.className='assistant-message';const answer=document.createElement('div');answer.className='assistant-answer assistant-empty';answer.textContent='Slovo či věta nenalezena nebo špatně napsána.';empty.append(answer);searchResults.append(empty);searchResults.classList.add('show');return}const ranked=[];notes.forEach((n,i)=>{n.blocks.forEach((b,j)=>{const text=b.title+' '+b.text;const hay=normalize(text);const score=terms.reduce((sum,t)=>sum+(hay.includes(t)?(hay.split(t).length-1):0),0);if(score>0&&b.text.trim())ranked.push({i,j,title:n.title,section:b.title,text:b.text,score})})});ranked.sort((a,b)=>b.score-a.score);const turn={question,results:ranked.slice(0,2)};conversation.push(turn);if(conversation.length>1)conversation.shift();renderAnswers();setTimeout(()=>{const index=conversation.indexOf(turn);if(index>=0){conversation.splice(index,1);if(conversation.length)renderAnswers();else{searchResults.innerHTML='';searchResults.classList.remove('show')}}},15000)
    }
    function renderAnswers(){searchResults.innerHTML='';conversation.slice().reverse().forEach(turn=>{const message=document.createElement('div');message.className='assistant-message';const q=document.createElement('div');q.className='assistant-question';q.textContent='Otázka: '+turn.question;const answer=document.createElement('div');answer.className='assistant-answer';const greeting=/^(ahoj|cau|cus|hi|hello|dobry den)$/i.test(normalize(turn.question).trim());if(turn.authorResults){answer.textContent='Počet záložek s tímto autorem: '+turn.authorResults.length+'.';turn.authorResults.forEach(r=>{const source=document.createElement('div');source.className='assistant-source';const openLink=document.createElement('button');openLink.type='button';openLink.textContent='Otázka '+String(r.i+1).padStart(2,'0')+' · '+r.title+' — '+r.author;openLink.addEventListener('click',()=>openQuestionModal(r.i));source.append(openLink);answer.append(source)})}else if(greeting){answer.textContent='Ahoj! Napiš mi otázku k maturitním tématům a já zkusím najít odpověď v materiálech na tomto webu.'}else if(!turn.results.length){answer.className='assistant-answer assistant-empty';answer.textContent='Slovo či věta nenalezena nebo špatně napsána.'}else{turn.results.forEach(r=>{const source=document.createElement('div');source.className='assistant-source';const openLink=document.createElement('button');openLink.type='button';openLink.textContent='Otázka '+String(r.i+1).padStart(2,'0')+' · '+r.title+' — '+r.section;openLink.addEventListener('click',()=>openQuestionModal(r.i,null,r.j,turn.question));source.append(openLink);answer.append(source)})}message.append(q,answer);searchResults.append(message)});searchResults.classList.add('show');searchResults.scrollTop=0}
    document.getElementById('askButton').addEventListener('click',ask);searchInput.addEventListener('keydown',e=>{if(e.key==='Escape'){searchResults.classList.remove('show');searchInput.blur()}if(e.key==='Enter'){e.preventDefault();ask()}});document.addEventListener('click',e=>{if(!e.target.closest('.searchbox'))searchResults.classList.remove('show')});    document.getElementById('closeBtn').addEventListener('click',close);overlay.addEventListener('click',e=>{if(e.target===overlay)close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&imageViewer.classList.contains('open')){e.preventDefault();e.stopImmediatePropagation();closeImageViewer();return}if(e.key==='Escape'&&summaryOverlay.classList.contains('open')){closeSummaryModal();return}if(e.key==='Escape'&&overlay.classList.contains('open'))close();if(overlay.classList.contains('open')&&!testTopicOpen&&e.key==='ArrowRight'&&active<19&&!e.target.isContentEditable){e.preventDefault();openQuestionModal(active+1)}if(overlay.classList.contains('open')&&!testTopicOpen&&active>0&&e.key==='ArrowLeft'&&!e.target.isContentEditable){e.preventDefault();openQuestionModal(active-1)}});document.getElementById('prevBtn').addEventListener('click',()=>openQuestionModal(active-1));document.getElementById('nextBtn').addEventListener('click',()=>openQuestionModal(active+1));    let highlightTimer=null;
    function highlightSearchText(query,sectionIndex){
      if(highlightTimer)clearTimeout(highlightTimer);
      const root=sectionIndex>=0?detail.querySelectorAll('.block')[sectionIndex]:detail;
      if(!root)return;
      const targets=sectionIndex>=0?[root.querySelector('h3'),root.querySelector('.study-text')]:[detail.querySelector('.detail-lead')];
      const stop=new Set(['co','je','jsou','to','se','na','do','v','ve','z','ze','a','i','o','u','s','k','ke','jak','jaky','jaka','jake','mi','me','pro','podle','ktera','ktery','ktere','muzes','vysvetli','popis','rekni','prosim']);
      const phrase=normalize(query).trim();
      const terms=phrase.split(/[^a-z0-9]+/).filter(t=>t.length>1&&!stop.has(t));
      const marks=[];
      targets.filter(Boolean).forEach(el=>{
        const walker=document.createTreeWalker(el,NodeFilter.SHOW_TEXT);
        const textNodes=[];while(walker.nextNode())textNodes.push(walker.currentNode);
        textNodes.forEach(node=>{
          const text=node.nodeValue||'';if(!text.trim())return;
          const chars=Array.from(text),starts=[],ends=[];let normalized='';let offset=0;
          chars.forEach(ch=>{const part=normalize(ch);for(let k=0;k<part.length;k++){starts.push(offset);ends.push(offset+ch.length)}normalized+=part;offset+=ch.length});
          let ranges=[];
          const find=(needle)=>{if(!needle)return;let from=0,at;while((at=normalized.indexOf(needle,from))>=0){const start=starts[at],end=ends[at+needle.length-1];if(start!==undefined&&end!==undefined)ranges.push([start,end]);from=at+Math.max(1,needle.length)}};
          find(phrase);if(!ranges.length)terms.forEach(find);
          ranges.sort((a,b)=>a[0]-b[0]);const unique=[];ranges.forEach(r=>{if(!unique.length||r[0]>=unique[unique.length-1][1])unique.push(r)});if(!unique.length)return;
          const fragment=document.createDocumentFragment();let cursor=0;unique.forEach(([start,end])=>{if(start>cursor)fragment.append(document.createTextNode(text.slice(cursor,start)));const mark=document.createElement('mark');mark.className='search-highlight';mark.textContent=text.slice(start,end);fragment.append(mark);marks.push(mark);cursor=end});if(cursor<text.length)fragment.append(document.createTextNode(text.slice(cursor)));node.replaceWith(fragment);
        });
      });
      highlightTimer=setTimeout(()=>marks.forEach(mark=>{if(mark.isConnected)mark.replaceWith(document.createTextNode(mark.textContent||''))}),3000);
    }
    const summaryOverlay=document.getElementById('summaryOverlay'),summaryModalTitle=document.getElementById('summaryModalTitle'),summaryModalBody=document.getElementById('summaryModalBody');let summaryReturnFocus=null;
    function openSummaryModal(i,trigger){summaryReturnFocus=trigger;const n=notes[i],items=pickRandomSummary(i);summaryModalTitle.textContent=n.title;document.getElementById('summaryCrumb').textContent=String(i+1).padStart(2,'0');summaryModalBody.innerHTML='';if(items){const list=document.createElement('ol');list.className='summary-points';items.slice(0,5).flatMap((item,index)=>[{item,number:index+1},{item:items[index+5],number:index+6}]).forEach(({item,number:itemNumber})=>{const li=document.createElement('li');const number=document.createElement('span');number.className='summary-point-number';number.textContent=String(itemNumber).padStart(2,'0');const text=document.createElement('span');text.className='summary-point-text';setMathText(text,item);li.append(number,text);list.append(li)});summaryModalBody.append(list)}else{const message=document.createElement('p');message.textContent=`Materiály k tématu „${n.title}“ zatím nejsou doplněné, proto pro něj shrnutí není k dispozici.`;summaryModalBody.append(message)}summaryOverlay.classList.add('open');summaryOverlay.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';document.getElementById('summaryCloseBtn').focus()}
    function closeSummaryModal(){summaryOverlay.classList.remove('open');summaryOverlay.setAttribute('aria-hidden','true');document.body.style.overflow=overlay.classList.contains('open')?'hidden':'';if(summaryReturnFocus&&summaryReturnFocus.isConnected)summaryReturnFocus.focus();summaryReturnFocus=null}
    document.getElementById('summaryCloseBtn').addEventListener('click',closeSummaryModal);summaryOverlay.addEventListener('click',e=>{if(e.target===summaryOverlay)closeSummaryModal()});    function openQuestionModal(i,focus,jumpTo=-1,query=''){ 
      resetTestState();setTestExitButton(false);if(typeof questionSearchTimer!=='undefined'&&questionSearchTimer){clearTimeout(questionSearchTimer);questionSearchTimer=null}active=i;lastFocus=focus||document.activeElement;overlay.classList.add('open');document.body.style.overflow='hidden';try{renderDetail()}catch(error){showModalRenderError(error)}document.getElementById('closeBtn').focus();
      requestAnimationFrame(()=>{const scroller=document.getElementById('modalScroll');if(jumpTo>=0){const target=detail.querySelectorAll('.block')[jumpTo];if(target)scroller.scrollTop=target.getBoundingClientRect().top-scroller.getBoundingClientRect().top+scroller.scrollTop-18}else scroller.scrollTop=0;if(query)highlightSearchText(query,jumpTo)});
    }
    function showSearchHistory(){
      if(searchInput.value.trim()||!searchHistory.length)return;
      searchResults.innerHTML='';searchResults.classList.add('search-history-list');
      const panel=document.createElement('div');const heading=document.createElement('div');heading.className='search-history-title';heading.textContent='Historie vyhledávání';panel.append(heading);
      searchHistory.slice(0,3).forEach(query=>{const item=document.createElement('button');item.type='button';item.className='search-history-item';item.textContent=query;item.addEventListener('click',e=>{e.stopPropagation();searchInput.value=query;searchResults.classList.remove('search-history-list');ask()});panel.append(item)});
      searchResults.append(panel);searchResults.classList.add('show');
    }
    searchInput.addEventListener('focus',showSearchHistory);
    searchInput.addEventListener('click',showSearchHistory);
    searchInput.addEventListener('input',()=>{const query=searchInput.value.trim();clearAuthorCardFilter();if(query)searchResults.classList.remove('show','search-history-list')});
    const questionSearchInput=document.getElementById('questionSearchInput'),questionSearchCount=document.getElementById('questionSearchCount');
    let questionSearchTimer=null;
    function clearQuestionSearch(){if(questionSearchTimer){clearTimeout(questionSearchTimer);questionSearchTimer=null}detail.querySelectorAll('.question-search-hit').forEach(mark=>mark.replaceWith(document.createTextNode(mark.textContent||'')));questionSearchCount.textContent='';questionSearchCount.hidden=true}
    function searchInCurrentQuestion(){
      clearQuestionSearch();const query=questionSearchInput.value.trim();if(!query)return;
      const wanted=normalize(query);if(!wanted)return;const hits=[];
      const walker=document.createTreeWalker(detail,NodeFilter.SHOW_TEXT);const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);
      nodes.forEach(node=>{if(node.parentElement&&node.parentElement.closest('[data-search-exclude]'))return;const text=node.nodeValue||'';if(!text.trim())return;const chars=Array.from(text),starts=[],ends=[];let normalized='',offset=0;chars.forEach(ch=>{const part=normalize(ch);for(let k=0;k<part.length;k++){starts.push(offset);ends.push(offset+ch.length)}normalized+=part;offset+=ch.length});let ranges=[],from=0,at;const directNeedle=query.toLocaleLowerCase("cs"),directText=text.toLocaleLowerCase("cs");while((at=directText.indexOf(directNeedle,from))>=0){ranges.push([at,at+directNeedle.length]);from=at+Math.max(1,directNeedle.length)}if(!ranges.length){from=0;while((at=normalized.indexOf(wanted,from))>=0){const start=starts[at],end=ends[at+wanted.length-1];if(start!==undefined&&end!==undefined)ranges.push([start,end]);from=at+Math.max(1,wanted.length)}}if(!ranges.length)return;const frag=document.createDocumentFragment();let cursor=0;ranges.forEach(([start,end])=>{if(start>cursor)frag.append(document.createTextNode(text.slice(cursor,start)));const mark=document.createElement('mark');mark.className='question-search-hit';mark.textContent=text.slice(start,end);frag.append(mark);hits.push(mark);cursor=end});if(cursor<text.length)frag.append(document.createTextNode(text.slice(cursor)));node.replaceWith(frag)});
      questionSearchCount.textContent=hits.length?`${hits.length}×`:'Nenalezeno';questionSearchCount.hidden=false;if(hits.length){const scroller=document.getElementById('modalScroll'),first=hits[0];scroller.scrollTop=first.getBoundingClientRect().top-scroller.getBoundingClientRect().top+scroller.scrollTop-18;questionSearchTimer=setTimeout(clearQuestionSearch,3000)}
    }
    document.getElementById('questionSearchButton').addEventListener('click',searchInCurrentQuestion);
    questionSearchInput.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();searchInCurrentQuestion()}if(e.key==='Escape'){clearQuestionSearch();questionSearchInput.value=''}});
    questionSearchInput.addEventListener('input',()=>{if(!questionSearchInput.value.trim())clearQuestionSearch()});
    let testTopicOpen=false,testTopicBag=[],currentTestQuestions=[],currentTestTopic=null,currentTestQuestion=0;
    const testBanks=[
      {note:0,items:[
        ['Jaké jsou tři základní skupiny technických materiálů?','Kovové, nekovové a kompozitní materiály. Volba závisí na funkci součásti a provozních podmínkách.'],
        ['Jak se dělí kovové materiály podle základního složení?','Na železné kovy, zejména oceli a litiny, a neželezné kovy, například hliník, měď, hořčík, titan, zinek a nikl.'],
        ['Uveďte příklady fyzikálních, mechanických, chemických a technologických vlastností.','Fyzikální: hustota a vodivost; mechanické: pevnost, tvrdost a houževnatost; chemické: odolnost proti korozi; technologické: obrobitelnost, svařitelnost a slévatelnost.'],
        ['Co vyjadřuje pevnost materiálu?','Schopnost odolávat působícímu zatížení bez porušení; zkoušet ji lze například tahem, tlakem, ohybem nebo smykem.'],
        ['Jaký je rozdíl mezi pružností a plasticitou?','Pružný materiál se po odlehčení vrací do původního tvaru; plastická deformace zůstává trvale i po odlehčení.'],
        ['Co je tvrdost a jakými metodami se měří?','Odolnost povrchu proti vnikání tvrdšího tělesa; běžné metody jsou Brinell, Rockwell a Vickers.'],
        ['Co znamená houževnatost a jak se liší křehký materiál?','Houževnatý materiál dokáže pohltit energii a odolává lomu; křehký se poruší s malou plastickou deformací.'],
        ['Co se zjišťuje tahovou zkouškou?','Zatěžováním zkušební tyče až do přetržení se stanovuje například mez kluzu, pevnost v tahu a tažnost.'],
        ['Co je únava materiálu?','Postupné poškozování při opakovaném nebo proměnném zatěžování, které může vést k lomu i při zatížení nižším než statická pevnost.'],
        ['Jak se obecně liší oceli a litiny?','Oceli se zpravidla tváří a obrábějí, litiny mají vyšší obsah uhlíku a obvykle se dobře odlévají.'],
        ['K čemu slouží kalení a popouštění?','Kalení zvyšuje tvrdost a pevnost; popouštění po kalení snižuje křehkost a upravuje výsledné vlastnosti.'],
        ['Co jsou neželezné kovy a uveďte jejich příklady.','Jsou to kovy, jejichž základem není železo; například hliník, měď, hořčík, titan, zinek a nikl.'],
        ['Jak se liší termoplast, reaktoplast a elastomer?','Termoplast lze teplem opakovaně změkčit, vytvrzený reaktoplast se znovu neroztaví a elastomer je pružný a po deformaci se vrací.'],
        ['Co je kompozitní materiál?','Materiál tvořený matricí a výztuží, jejichž kombinací lze dosáhnout vlastností vhodných pro konkrétní použití.'],
        ['Jak lze omezovat korozi konstrukční součásti?','Vhodnou volbou materiálu a konstrukce, ochrannými povlaky či nátěry, katodickou ochranou a pravidelnou údržbou.']
      ]},
      {note:9,items:[
        ['Co je nedestruktivní zkoušení a kde se používá?','NDT kontroluje materiál nebo výrobek bez poškození jeho použitelnosti; používá se při výrobě, přejímce, údržbě i provozu.'],
        ['Jaké základní metody se označují zkratkami VT, PT, MT, UT, RT, ET a LT?','Vizuální, kapilární, magnetická prášková, ultrazvuková, radiografická, vířivoproudá a zkoušení těsnosti.'],
        ['Jakou metodu lze zvolit pro viditelné povrchové vady?','Základní je vizuální zkouška VT; podle materiálu lze použít také PT, MT u feromagnetik nebo ET u vodivých materiálů.'],
        ['Na jaké vady je určena kapilární zkouška PT?','Na trhliny, póry a další nespojitosti otevřené na čistý, přístupný a neporézní povrch.'],
        ['Popište základní postup kapilární zkoušky.','Povrch se očistí a vysuší, nanese se penetrant a nechá působit, přebytek se odstraní, nanese se vývojka a vyhodnotí se indikace.'],
        ['Jak funguje magnetická prášková zkouška MT?','Vada naruší magnetický tok zmagnetovaného dílu, vzniklé rozptylové pole zachytí magnetické částice.'],
        ['Na jaké materiály lze použít MT a proč nelze zkoušet hliník?','Pouze na feromagnetické materiály, například oceli a některé litiny; hliník není feromagnetický.'],
        ['Proč se magnetická zkouška někdy provádí ve dvou směrech?','Vada se nejlépe zachytí, když přerušuje magnetický tok přibližně kolmo; různými směry magnetování se zvýší šance na její odhalení.'],
        ['Vysvětlete princip ultrazvukové zkoušky UT.','Sonda vysílá ultrazvukové impulsy a přijímá odrazy od vady nebo stěny; čas a amplituda echa pomáhají určit polohu a velikost indikace.'],
        ['K čemu slouží vazební prostředek při UT?','Zajišťuje přenos ultrazvukové vlny mezi sondou a zkoušeným dílem.'],
        ['Jaký je princip radiografické zkoušky RT?','Rentgenové nebo gama záření prochází dílem a dopadá na film či digitální detektor; rozdílné zeslabení může zobrazit póry nebo vměstky.'],
        ['Jaké bezpečnostní opatření vyžaduje RT?','Ionizující záření smí používat oprávněné osoby v řízeném prostoru s radiační ochranou a bezpečnostním pásmem.'],
        ['Na jaké materiály a vady se hodí vířivoproudá zkouška ET?','Na vodivé materiály; odhaluje povrchové a blízko povrchu ležící vady a změny vlastností či tloušťky.'],
        ['Jakými způsoby lze zkoušet těsnost LT?','Například bublinkovou metodou, sledováním poklesu tlaku nebo vakua, stopovým plynem či kontrolou prosakování kapaliny.'],
        ['Jak rozlišit indikaci od skutečné a nepřípustné vady?','Indikace je odezva zkoušky; podle kritérií se vyhodnotí, zda odpovídá skutečné vadě a zda je přípustná.']
      ]},
      {note:17,items:[
        ['Vysvětlete princip třískového obrábění.','Břit proniká do materiálu, vrstva se deformuje a oddělí ve formě třísky; na obrobku vzniká nová plocha.'],
        ['Jak se dělí obráběcí metody podle geometrie břitu?','Na metody s definovanou geometrií břitu, s neurčitou geometrií břitu a na nekonvenční metody.'],
        ['Uveďte příklady obrábění s definovanou a neurčitou geometrií.','Definovaný břit mají soustružení, frézování a vrtání; neurčitou geometrii zrn mají broušení, honování a lapování.'],
        ['Co tvoří řezný klín a jaké jsou jeho základní úhly?','Tvoří jej čelo a hřbet s břitem; základní úhly jsou čelní γ, hřbetní α a úhel klínu β.'],
        ['Jak vzniká tříska při obrábění?','Materiál se před břitem plasticky deformuje, oddělí se smykem a tříska odchází po čele nástroje.'],
        ['Jaké základní druhy třísek se mohou tvořit?','Plynulá, článkovitá a elementární tříska; jejich vznik závisí na materiálu a řezných podmínkách.'],
        ['Jaké složky řezné síly působí při obrábění?','Hlavní řezná síla Fc, posuvová síla Ff a pasivní síla Fp; zatěžují nástroj, obrobek i stroj.'],
        ['Kde při řezání vzniká teplo?','Především při plastické deformaci materiálu, smykovém oddělování třísky a tření v místě řezu.'],
        ['Co znamenají řezné podmínky v, n, f, vf a ap?','v je řezná rychlost, n otáčky, f posuv na otáčku, vf posuvová rychlost a ap hloubka řezu.'],
        ['Jaký vztah se používá pro výpočet otáček n?','n = (v × 1000) / (3,14 × D), kde v je v m/min, D průměr v mm a n vyjde v min⁻¹.'],
        ['Jaký bývá vliv zvýšení řezné rychlosti na nástroj?','Zvyšuje produktivitu, ale zpravidla také tepelné zatížení a opotřebení, takže může zkrátit životnost nástroje.'],
        ['Uveďte příklady řezných materiálů a jejich vlastnosti.','HSS je houževnatá nástrojová ocel; slinutý karbid umožňuje vyšší rychlosti, keramika práci za vysokých teplot, CBN tvrdé materiály a diamant neželezné či abrazivní materiály.'],
        ['Jaké projevy opotřebení nástroje je třeba sledovat?','Opotřebení hřbetu, kráter na čele, vylamování břitu, nárůstek a tepelné poškození; mohou zhoršit rozměr i povrch.'],
        ['Co ovlivňuje jakost obrobeného povrchu?','Posuv, geometrie a ostrost nástroje, materiál, vibrace, tuhost soustavy, řezná rychlost a tepelné poměry.'],
        ['Jaké zásady podporují bezpečné obrábění?','Správně upnout obrobek i nástroj, nastavit vhodné řezné podmínky, používat kryty a třísky odstraňovat až po zastavení.']
      ]},
      {note:2,items:[
        ['Jak při vrtání na soustruhu probíhá hlavní pohyb?','Obrobek se otáčí; vrták upnutý v koníku se neotáčí a posouvá se v ose obrobku.'],
        ['Které základní části má šroubovitý vrták?','Stopku, pracovní část se šroubovitými drážkami a hrot s hlavními břity a příčným ostřím.'],
        ['K čemu slouží šroubovité drážky vrtáku?','Pomáhají odvádět třísky z otvoru a přivádět řeznou kapalinu k břitům.'],
        ['Proč mají být oba hlavní břity stejně dlouhé a souměrné?','Nesouměrné břity způsobují řezání převážně jedním břitem, větší otvor, zahřívání a rychlejší opotřebení.'],
        ['Jaký bývá přibližný úhel špičky běžného vrtáku pro ocel?','Přibližně 118°; pro jiné materiály a nástroje se může lišit.'],
        ['Kdy se běžně volí vrták z rychlořezné oceli HSS?','Pro běžné univerzální vrtání ocelí a mnoha dalších kovů; HSS si zachovává tvrdost i při zahřátí.'],
        ['K čemu se hodí vrták z HSS-Co?','Lépe snáší vyšší teploty a používá se například pro nerezové a pevnější materiály.'],
        ['Jaká je hlavní výhoda a nevýhoda slinutého karbidu?','Je velmi tvrdý a dovoluje vyšší řezné rychlosti, ale je křehčí a citlivý na rázy a chvění.'],
        ['Co může přinést povlak TiN?','Může snížit tření a opotřebení a prodloužit životnost; nenahradí správnou volbu ani nabroušení vrtáku.'],
        ['Jaký je rozdíl mezi válcovou a Morseovou kuželovou stopkou?','Válcová stopka se obvykle upíná do sklíčidla; Morseův kužel se zasouvá do odpovídajícího kužele pinoly nebo pouzdra.'],
        ['Proč se před přesným vrtáním používá středicí vrták?','Vytvoří vodicí důlek, který pomůže navést následný vrták a omezí jeho vychýlení.'],
        ['Jak postupovat při vrtání hlubokého otvoru?','Přerušovat posuv, vrták povytáhnout a umožnit odvod třísek; třísky čistit až po zastavení stroje.'],
        ['Jaký vztah se používá pro výpočet otáček vrtáku?','n = (v × 1000) / (3,14 × D), kde v je řezná rychlost v m/min a D průměr vrtáku v mm.'],
        ['Jaké otáčky přibližně vyjdou pro v = 25 m/min a D = 10 mm?','n = (25 × 1000) / (3,14 × 10) ≈ 796 min⁻¹; na soustruhu se zvolí nejbližší vhodný dostupný stupeň.'],
        ['Jak bezpečně odstranit třísky při vrtání na soustruhu?','Nejprve zastavit stroj a použít háček nebo štětec; třísky nikdy neodstraňovat rukou.']
      ]},
      {note:3,items:[
        ['Co je termoplast a jak reaguje na zahřátí?','Při zahřátí měkne nebo taje a po ochlazení tuhne; tvarování lze opakovat, materiál se však může degradovat.'],
        ['Proč vytvrzený reaktoplast znovu neroztavíme?','Při vytvrzení vznikne nevratně zesítěná prostorová struktura; při vysoké teplotě se reaktoplast rozkládá.'],
        ['Co je typické pro elastomer?','Je pružný a po deformaci se z velké části vrací do původního tvaru.'],
        ['Z čeho se skládá polymerní kompozit?','Z polymerní matrice, která spolupracuje s výztuží, například se skelnými nebo uhlíkovými vlákny.'],
        ['Jak se liší amorfní a semikrystalický termoplast?','Amorfní má neuspořádané řetězce a měkne v širším teplotním rozmezí; semikrystalický obsahuje krystalické i amorfní oblasti a má výraznější teplotu tání.'],
        ['Uveďte dvě obecné vlastnosti plastů a jejich důležitou nevýhodu.','Často mají nízkou hmotnost a odolávají korozi, ale jejich pevnost a teplotní odolnost se výrazně liší a mohou při zatížení téct či teplem degradovat.'],
        ['K čemu slouží změkčovadla a stabilizátory?','Změkčovadla zvyšují ohebnost a měkkost směsi; stabilizátory zpomalují degradaci teplem, světlem nebo oxidací.'],
        ['Uveďte příklady výrobků z PET, PE, PP a PVC.','PET: nápojová lahev nebo vlákno; PE: fólie či nádoba; PP: krabička či víčko; PVC: potrubí nebo kabelový plášť.'],
        ['Jak probíhá vstřikování plastů?','Granulát se roztaví, tavenina se vstříkne do uzavřené formy, následuje dotlak a chlazení nebo vytvrzení a poté vyjmutí výrobku.'],
        ['Jaké výrobky se typicky vyrábějí vytlačováním?','Trubky, profily, fólie a desky; tavenina se nepřetržitě protlačuje tvarovací hubicí.'],
        ['Jak vzniká dutý výrobek vyfukováním?','Tlak vzduchu roztáhne zahřátý dutý polotovar ke stěnám uzavřené formy.'],
        ['Jak funguje tvarování plastové desky za tepla?','Zahřátá deska nebo fólie se přitlačí k formě podtlakem, přetlakem nebo mechanicky a po ochlazení se sejme.'],
        ['Uveďte dvě příčiny nedostříknutí při vstřikování.','Například nízká teplota nebo tlak, krátké plnění či špatné odvzdušnění formy.'],
        ['Jak omezit tavení a deformaci plastu při obrábění?','Použít ostrý nástroj vhodné geometrie, správně podepřít obrobek a zajistit odvod třísek a tepla.'],
        ['Jaký je rozdíl mezi mechanickou a chemickou recyklací?','Mechanická recyklace odpad třídí, čistí, drtí a taví; chemická recyklace polymer či odpad chemicky rozkládá na suroviny nebo jiné produkty.']
      ]},
      {note:13,items:[
        ['Vysvětlete princip soustružení.','Obrobek se otáčí kolem své osy a jednobřitý nástroj odebírá materiál; vznikají zejména rotační plochy.'],
        ['Co je hlavní řezný pohyb, posuv a přísuv při soustružení?','Hlavní řezný pohyb je rotace obrobku, posuv je pohyb nástroje vůči obrobku a přísuv radiálně nastavuje hloubku řezu.'],
        ['Jaký je vztah mezi radiální hloubkou řezu ap a změnou průměru?','Při vnějším soustružení se průměr zmenší přibližně o dvojnásobek ap.'],
        ['K čemu slouží lože soustruhu?','Je základnou stroje a vede suport i koník ve správné vzájemné poloze.'],
        ['Jakou funkci má vřeteník?','Obsahuje vřeteno a převody otáček a přenáší pohyb na obrobek.'],
        ['K čemu slouží suport a nožová hlava?','Suport zajišťuje podélný a příčný pohyb nástroje; nožová hlava upíná nůž a nastavuje jeho polohu.'],
        ['Kdy se používá tříčelisťové a kdy čtyřčelisťové sklíčidlo?','Tříčelisťové samočinně centruje pravidelné kruhové či šestihranné polotovary; čtyřčelisťové nezávislé umožňuje upnout nepravidelný tvar nebo přesně vystředit obrobek.'],
        ['K čemu slouží luneta?','Podpírá dlouhý štíhlý obrobek a omezuje jeho průhyb či chvění.'],
        ['Jaký je rozdíl mezi podélným a příčným posuvem?','Podélný probíhá rovnoběžně s osou obrobku a vytváří válcovou plochu; příčný míří k ose nebo od ní a používá se například při čelním soustružení.'],
        ['Jakou funkci má úhel čela γ a úhel hřbetu α?','Úhel čela ovlivňuje tvorbu a odchod třísky i pevnost břitu; úhel hřbetu omezuje tření hřbetu o obrobený povrch.'],
        ['Jaké nástroje se používají pro řezání závitů a pro vnitřní obrábění?','Závitový nůž pro závity a vnitřní vyvrtávací nůž pro obrábění otvorů.'],
        ['Jak se vypočítá počet otáček při soustružení?','n = (v × 1000) / (3,14 × D), kde v je řezná rychlost v m/min a D průměr v mm.'],
        ['V jakých jednotkách se běžně udává posuv na otáčku a hloubka řezu?','Posuv f v mm/ot a hloubka řezu ap v mm.'],
        ['Proč se nástroj upíná s co nejmenším vyložením a přibližně do výšky osy?','Malé vyložení zvyšuje tuhost a omezuje chvění; správná výška pomáhá dosáhnout správné geometrie řezu.'],
        ['Které bezpečnostní zásady platí u rotujícího soustruhu?','Odstranit klíč sklíčidla, používat ochranné brýle, nenosit rukavice u rotace, neměřit za chodu a třísky odstraňovat až po zastavení stroje.']
      ]},
      {note:12,items:[
        ['Jaký je účel zkoušení materiálů?','Ověřit, zda materiál, polotovar nebo výrobek splňuje požadované vlastnosti a kritéria.'],
        ['Jak se liší destruktivní a nedestruktivní zkouška?','Destruktivní vzorek poruší nebo trvale změní; nedestruktivní hledá vady bez znehodnocení použitelnosti dílu.'],
        ['Které skupiny zkoušek materiálů znáte?','Mechanické, technologické, metalografické, chemické a nedestruktivní.'],
        ['Popište průběh tahové zkoušky.','Normalizovaný vzorek se upne a zatěžuje tahem až do přetržení; měří se síla a prodloužení.'],
        ['Co vyjadřuje mez kluzu Re nebo Rp0,2?','Napětí, při kterém začíná významná trvalá deformace; Rp0,2 se stanoví smluvní metodou.'],
        ['Jaký je rozdíl mezi Rm, tažností A a kontrakcí Z?','Rm je nejvyšší napětí při tahu, A prodloužení po přetržení a Z zmenšení průřezu v místě lomu.'],
        ['V čem se liší pružná a plastická deformace?','Pružná po odlehčení zmizí, plastická zůstane trvale.'],
        ['Jak se provádí tlaková zkouška a co může výsledek zkreslit?','Vzorek se stlačuje mezi deskami; u štíhlého tělesa může působit vybočení a tření.'],
        ['Co měří metoda Brinell?','Průměr vtisku vytvořeného kuličkou z tvrdokovu při stanoveném zatížení.'],
        ['Na jakém principu pracuje Rockwell?','Tvrdost se vyhodnocuje z hloubky vtisku při předepsaném zatížení.'],
        ['Jak se vyhodnocuje metoda Vickers?','Diamantový jehlan vytvoří vtisk a měří se jeho úhlopříčky.'],
        ['Co zjišťuje Charpyho rázová zkouška?','Energii pohlcenou při přeražení vrubového vzorku a tím rázovou houževnatost.'],
        ['Co sleduje únavová zkouška?','Poškození nebo počet cyklů do lomu při opakovaném či proměnném zatížení.'],
        ['Co je tečení materiálu?','Časově závislá deformace při dlouhodobém zatížení, často za zvýšené teploty.'],
        ['Co má obsahovat protokol o zkoušce?','Identifikaci vzorku, metodu a podmínky, naměřené hodnoty s jednotkami a vyhodnocení podle kritérií.']
      ]},
      {note:18,items:[
        ['Co je výrobní postup?','Plánovaný sled operací, který převádí požadavky výkresu na bezpečně a opakovatelně vyrobenou součást.'],
        ['Jaký je rozdíl mezi výrobním a technologickým procesem?','Výrobní proces zahrnuje i pomocné činnosti; technologický proces přímo mění tvar, rozměr, vlastnosti nebo polohu součásti.'],
        ['Jaké druhy výroby rozlišujeme podle množství?','Kusovou, malosériovou, sériovou a hromadnou.'],
        ['Uveďte hlavní technologické procesy.','Odlévání, tváření, obrábění, spojování, tepelné zpracování, povrchové úpravy a montáž.'],
        ['Jakými kroky se tvoří výrobní postup?','Rozbor výkresu, volba polotovaru, pořadí operací, volba stroje a upnutí, nástrojů, parametrů, kontroly a ověření.'],
        ['Co technolog posuzuje při rozboru výkresu?','Tvar, rozměry, tolerance, drsnost, materiál, tepelné zpracování, závity a funkční plochy.'],
        ['Proč musí mít polotovar přídavek?','Aby bylo možné odstranit okuje, nerovnosti a nepřesnosti a dosáhnout konečného rozměru a povrchu.'],
        ['Co obsahuje technologický postup?','Pořadí operací, pracoviště, ustavení, nástroje, měřidla, parametry a kontrolní body.'],
        ['Jaký je účel operačního návodu a průvodky?','Operační návod popisuje podrobně jednu operaci; průvodka identifikuje díl a zaznamenává jeho průchod výrobou.'],
        ['Popište základní výrobu stupňovité hřídele.','Příprava tyče, zarovnání čela a středění, hrubování, případné tepelné zpracování, dokončení průměrů, funkční prvky a kontrola.'],
        ['Proč se hrubování obvykle provádí před dokončováním?','Nejprve se odebere většina přídavku; dokončovací operace pak dosáhne předepsané tolerance a jakosti.'],
        ['Jak se liší technologické a předmětné uspořádání výroby?','Technologické sdružuje stroje stejného druhu; předmětné řadí pracoviště podle toku výrobku.'],
        ['Vysvětlete kusový, seřizovací a průběžný čas.','Kusový je výroba jednoho kusu, seřizovací příprava dávky a průběžný doba od zahájení po dokončení včetně čekání a dopravy.'],
        ['Jak se postupuje při zjištění neshodného kusu?','Oddělit a označit dávku, neshodu zaznamenat, zjistit příčinu, schválit nápravu a následně ověřit výsledek.'],
        ['Jaké zásady bezpečnosti platí při výrobě?','Zkontrolovat stroj, nástroje a kryty, používat předepsané ochranné prostředky a dodržovat návod i pracovní postup.']
      ]}
    ];
    function shuffled(items){const result=items.slice();for(let i=result.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[result[i],result[j]]=[result[j],result[i]]}return result}
    function buildQuestionPool(bank){return bank.items.slice()}
    function startRandomTest(){const available=testBanks.filter(bank=>bank.items.length>=15);if(!testTopicBag.length||testTopicBag.some(note=>!available.some(bank=>bank.note===note))){testTopicBag=shuffled(available.map(bank=>bank.note))}const nextNote=testTopicBag.pop();const bank=available.find(item=>item.note===nextNote)||available[0];currentTestTopic=bank;currentTestQuestions=shuffled(buildQuestionPool(bank)).slice(0,15);currentTestQuestion=0;renderTestQuestion()}
    function openTestTopic(){resetTestState();testTopicOpen=true;setTestExitButton(true);lastFocus=document.getElementById('openTestTab');overlay.classList.add('open');document.body.style.overflow='hidden';document.querySelector('.question-search').style.display='none';document.getElementById('modalCrumb').textContent='Test';document.getElementById('prevBtn').hidden=true;document.getElementById('nextBtn').hidden=true;document.getElementById('footCount').textContent='Test';try{startRandomTest()}catch(error){showModalRenderError(error)}document.getElementById('closeBtn').focus()}
    let submittedAnswers=[];const testStopWords=new Set(['jako','nebo','ktere','ktery','kterou','ktera','jeho','jejich','jsou','jsme','jsem','byly','byla','bude','muze','mohou','podle','napriklad','proto','protoze','tento','tato','toto','tedy','take','zejmena','priblizne','material','materialu','pouziva','pouzivaji','vznika','pomaha','umoznuje','casti','maji','pri']);const testWords=text=>new Set(normalize(text).split(/[^a-z0-9]+/).filter(word=>word.length>3&&!testStopWords.has(word)));
    function updateTestProgress(){const count=submittedAnswers.filter(value=>value!==undefined).length;const progress=document.getElementById('quizProgress');if(progress)progress.textContent='Započítáno '+count+' / 15. Enter odpověď započítá; pole zůstává upravitelné.';const evaluate=detail.querySelector('.quiz-evaluate');if(evaluate)evaluate.hidden=count<15}
    function invalidateTestEvaluation(){const result=detail.querySelector('.quiz-result'),evaluate=detail.querySelector('.quiz-evaluate');if(result)result.hidden=true;if(evaluate)evaluate.disabled=false;detail.querySelectorAll('.quiz-item').forEach(item=>item.classList.remove('quiz-correct','quiz-incorrect'))}
    function submitTestAnswer(index,input,status){const response=input.value.trim();if(!response){submittedAnswers[index]=undefined;status.textContent='Nejdřív napiš odpověď.';updateTestProgress();input.focus();return}submittedAnswers[index]=response;status.textContent='Odpověď započítána. Můžeš ji kdykoli upravit.';input.closest('.quiz-item').classList.add('quiz-answered');invalidateTestEvaluation();updateTestProgress();const next=Array.from(detail.querySelectorAll('.quiz-item')).find((item,i)=>submittedAnswers[i]===undefined);if(next)next.scrollIntoView({behavior:'smooth',block:'center'});else detail.querySelector('.quiz-evaluate').scrollIntoView({behavior:'smooth',block:'center'})}
    function testWordsSimilar(left,right){if(left===right)return true;const short=left.length<=right.length?left:right,long=left.length<=right.length?right:left;if(short.length>=5&&long.startsWith(short.slice(0,5)))return true;if(Math.abs(left.length-right.length)>1||Math.min(left.length,right.length)<6)return false;let differences=0,i=0,j=0;while(i<left.length&&j<right.length){if(left[i]===right[j]){i++;j++;continue}if(++differences>1)return false;if(left.length>right.length)i++;else if(right.length>left.length)j++;else{i++;j++}}if(i<left.length||j<right.length)differences++;return differences<=1}
    function evaluateTest(){let correctCount=0;detail.querySelectorAll('.quiz-item').forEach((item,index)=>{const expected=currentTestQuestions[index][1],expectedWords=testWords(expected),givenWords=testWords(item.querySelector('.quiz-response').value),matched=[...expectedWords].filter(word=>[...givenWords].some(actual=>testWordsSimilar(word,actual))),scoreBase=Math.min(expectedWords.size,Math.max(5,givenWords.size)),coverage=scoreBase?matched.length/scoreBase:0,threshold=Math.max(2,Math.ceil(scoreBase*.2)),accepted=matched.length>=threshold&&coverage>=.3,complete=accepted&&coverage>=.75&&matched.length>=Math.min(4,expectedWords.size);if(accepted)correctCount++;item.classList.add(accepted?'quiz-correct':'quiz-incorrect');const status=item.querySelector('.quiz-submit-status');const percent=Math.round(coverage*100);status.textContent=complete?'Správně a dostatečně úplně ('+percent+' % shody).':accepted?'Odpověď se blíží správné, ale může být neúplná ('+percent+' % shody). Úplnější alternativa je níže.':'Odpověď je neúplná nebo se málo kryje se vzorem ('+percent+' % shody). Možná odpověď je níže.';const answer=item.querySelector('.quiz-answer');setMathText(answer,(complete?'Vzorová odpověď: ':'Možná úplnější odpověď: ')+expected);answer.hidden=false});const result=detail.querySelector('.quiz-result');result.hidden=false;result.textContent='Výsledek: '+correctCount+' z 15 odpovědí se alespoň částečně blíží řešení. U neúplných odpovědí je níže nabídnuta úplnější formulace.';detail.querySelector('.quiz-evaluate').disabled=true;document.getElementById('modalScroll').scrollTo({top:0,behavior:'smooth'})}
    function renderTestQuestion(){const bank=currentTestTopic||testBanks[0];currentTestTopic=bank;const topic=notes[bank.note]||notes[0];submittedAnswers=Array(15);document.getElementById('modalCrumb').textContent='Test';document.getElementById('footCount').textContent='15 otázek';detail.innerHTML='';const kicker=document.createElement('div');kicker.className='detail-kicker';kicker.textContent='TEST · NÁHODNÉ TÉMA';const title=document.createElement('h2');title.id='detailTitle';title.textContent=topic.title;const lead=document.createElement('div');lead.className='detail-lead';lead.id='quizProgress';detail.append(kicker,title,lead);currentTestQuestions.forEach((entry,index)=>{const section=document.createElement('section');section.className='block quiz-item';const heading=document.createElement('h3');heading.textContent='Otázka '+(index+1);const question=document.createElement('div');question.className='study-text';question.textContent=String(entry[0]??'');const answerInput=document.createElement('textarea');answerInput.className='quiz-response';answerInput.rows=3;answerInput.placeholder='Napiš svou odpověď…';answerInput.setAttribute('aria-label','Odpověď na otázku '+(index+1));const status=document.createElement('span');status.className='quiz-submit-status';status.setAttribute('aria-live','polite');const answer=document.createElement('div');answer.className='quiz-answer';answer.hidden=true;answer.textContent=String(entry[1]??'');answerInput.addEventListener('keydown',event=>{if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();submitTestAnswer(index,answerInput,status)}});answerInput.addEventListener('input',()=>{if(submittedAnswers[index]!==undefined){submittedAnswers[index]=undefined;section.classList.add('quiz-edited');section.classList.remove('quiz-answered');status.textContent='Upravená odpověď čeká na potvrzení Enterem.';invalidateTestEvaluation();updateTestProgress()}});const controls=document.createElement('div');controls.className='quiz-controls';controls.append(status);section.append(heading,question,answerInput,controls,answer);detail.append(section)});const evaluate=document.createElement('button');evaluate.type='button';evaluate.className='done-btn quiz-evaluate';evaluate.textContent='Vyhodnotit test';evaluate.hidden=true;evaluate.addEventListener('click',evaluateTest);const result=document.createElement('div');result.className='quiz-result';result.hidden=true;detail.append(evaluate,result);updateTestProgress();document.getElementById('modalScroll').scrollTop=0}
    document.getElementById('openTestTab').addEventListener('click',openTestTopic)
    renderGrid();
  </script>
</body>
</html>








<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f3ee">
  <title>Maturitní otázky · PT2</title>
  <style>
    :root{--paper:#090a09;--ink:#f2f1eb;--muted:#aaa99f;--line:#30322d;--green:#a5c68e;--lime:#d9ed83;--white:#141613;--serif:Georgia,'Times New Roman',serif;--sans:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}button{font:inherit;color:inherit}.page{max-width:1240px;margin:auto;padding:30px 46px 76px}.topbar{display:flex;justify-content:space-between;align-items:center;padding:7px 0 25px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:650;letter-spacing:.01em}.brandmark{width:25px;height:25px;display:grid;place-items:center;background:var(--green);color:#10130e;border-radius:8px;font:italic 16px var(--serif)}.course{font-size:11px;letter-spacing:.13em;font-weight:700;color:var(--green);border:1px solid #495343;padding:7px 10px;border-radius:99px}.hero{padding:66px 0 35px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:700}.hero h1{font:500 clamp(42px,7vw,76px)/.98 var(--serif);letter-spacing:-.045em;margin:18px 0 17px}.hero p{font-size:15px;color:#aaa99f;max-width:550px;line-height:1.7;margin:0}.toolbar{display:flex;align-items:center;justify-content:space-between;padding:25px 0 14px;border-bottom:1px solid var(--line);margin-bottom:19px}.section-title{font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.progress{font-size:12px;color:var(--muted)}.progress strong{color:var(--green)}.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.card{position:relative;text-align:left;min-height:166px;padding:17px 17px 15px;background:var(--white);border:1px solid var(--line);border-radius:12px;cursor:pointer;display:flex;flex-direction:column;transition:transform .18s,border-color .18s,box-shadow .18s}.card:hover{transform:translateY(-3px);border-color:#78876c;box-shadow:0 8px 22px #0008}.card:focus-visible,.close:focus-visible,.nav-btn:focus-visible{outline:3px solid #93ad51;outline-offset:3px}.card-top{display:flex;justify-content:space-between;align-items:center}.number{font:italic 20px var(--serif);color:#a5c68e}.status{font-size:10px;color:#aaa99f}.card h2{font:500 18px/1.25 var(--serif);margin:auto 0 8px;letter-spacing:-.01em}.card-foot{display:flex;justify-content:space-between;align-items:center;color:#aaa99f;font-size:11px}.arrow{font-size:17px;line-height:1;color:var(--green)}.hint{margin-top:20px;font-size:11px;color:#85867e}
    .overlay{position:fixed;inset:0;background:#000d;backdrop-filter:blur(4px);z-index:10;display:none;align-items:center;justify-content:center;padding:28px}.overlay.open{display:flex}.modal{width:min(900px,100%);height:min(780px,100%);background:var(--paper);border:1px solid #34362f;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 28px 90px #0009;animation:rise .22s ease-out}@keyframes rise{from{opacity:0;transform:translateY(12px) scale(.99)}to{opacity:1;transform:none}}.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid var(--line);background:#10120f;flex-shrink:0}.modal-mark{display:flex;align-items:center;gap:11px;color:var(--muted);font-size:12px}.modal-mark b{color:var(--green);font:italic 19px var(--serif)}.close{border:1px solid var(--line);background:#1a1c18;width:34px;height:34px;border-radius:50%;font-size:18px;cursor:pointer}.modal-scroll{overflow-y:auto;overscroll-behavior:contain;flex:1}.detail{max-width:700px;margin:0 auto;padding:43px 36px 60px}.detail-kicker{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--green);font-weight:700}.detail h2{font:500 clamp(32px,5vw,50px)/1.06 var(--serif);letter-spacing:-.035em;margin:14px 0}.detail-lead{font:17px/1.65 var(--serif);color:#b3b2a9;max-width:600px;margin-bottom:35px}.editor-note{display:flex;gap:9px;padding:12px 14px;margin:0 0 29px;border:1px solid #3a4530;border-radius:8px;background:#171c14;color:#c3c9b5;font-size:12px;line-height:1.5}.editor-note span{color:var(--green)}.block{padding:22px 0;border-top:1px solid var(--line)}.block h3{font:500 22px var(--serif);margin:0 0 10px}.editable{outline:none;white-space:pre-wrap;line-height:1.75;font-size:14px;color:#d0d0c8;min-height:28px;border-radius:4px}.editable:focus{box-shadow:0 0 0 3px #455532}.editable:empty:before{content:attr(data-placeholder);color:#85867e}.detail-tools{margin-top:27px;display:flex;align-items:center;gap:10px}.done-btn{background:var(--green);border:0;border-radius:7px;color:#10130e;padding:11px 15px;font-size:12px;font-weight:650;cursor:pointer}.done-btn.done{background:#31402c;color:#e5f2ce}.save-label{font-size:11px;color:#aaa99f}.modal-foot{border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:11px 18px;background:#10120f;flex-shrink:0}.nav-btn{border:1px solid var(--line);background:#1a1c18;border-radius:7px;padding:8px 11px;cursor:pointer;font-size:12px}.nav-btn:disabled{opacity:.35;cursor:default}.foot-count{font-size:11px;color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:1000px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:720px){.page{padding:20px 20px 50px}.hero{padding:49px 0 26px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{min-height:145px;padding:14px}.overlay{padding:10px}.modal{height:100%;border-radius:12px}.detail{padding:34px 23px 45px}.modal-head{padding:12px 15px}}@media(max-width:370px){.grid{grid-template-columns:1fr}.card{min-height:124px}}
  </style>
  <style>
    .summary-toggle{display:inline-flex;align-items:center;gap:8px;margin:0 0 20px;padding:9px 13px;border:1px solid #526447;border-radius:7px;background:#171c14;color:#c9e4aa;font:600 12px var(--sans);cursor:pointer;transition:background .18s,border-color .18s}.summary-toggle:hover{background:#20271b;border-color:#829c6e}.summary-toggle:focus-visible{outline:3px solid #93ad51;outline-offset:3px}.summary-panel{margin:0 0 24px;padding:16px 18px;border:1px solid #3a4530;border-radius:9px;background:#141811;color:#d0d5c8;font-size:14px;line-height:1.75}.summary-panel[hidden]{display:none!important}.summary-panel p{margin:0}.summary-panel ul{margin:0;padding-left:20px}.summary-panel li+li{margin-top:7px}
    .summary-modal{width:min(780px,100%);height:min(620px,100%)}.summary-detail{max-width:780px}.summary-detail h2{margin-bottom:22px}.summary-detail .summary-panel{margin:0}.summary-detail .summary-panel ul{margin:0;padding-left:20px}.summary-detail .summary-panel li+li{margin-top:10px}    .study-text{white-space:pre-wrap;line-height:1.75;font-size:14px;color:#d0d0c8;min-height:28px}.math-fraction{display:inline-grid;grid-template-rows:auto auto;vertical-align:middle;text-align:center;line-height:1.15;margin:0 4px;font-size:.96em}.math-fraction span:first-child{padding:0 5px 2px;border-bottom:1px solid currentColor}.math-fraction span:last-child{padding:2px 5px 0}.hero{display:flex;align-items:center;justify-content:space-between;gap:38px}.hero-copy{flex:1}.searchbox{position:relative;width:min(360px,42%);align-self:center}.searchbox label{display:block;margin-bottom:9px;color:#aaa99f;font-size:11px;font-weight:650;letter-spacing:.1em;text-transform:uppercase}.search-field{display:flex;align-items:center;gap:10px;background:#141613;border:1px solid #383a34;border-radius:10px;padding:0 13px;transition:border-color .2s}.search-field:focus-within{border-color:#829c6e}.search-icon{color:var(--green);font-size:17px}.search-field input{width:100%;height:47px;border:0;outline:0;background:transparent;color:var(--ink);font:14px var(--sans)}.search-field input::placeholder{color:#777970}.search-results{position:absolute;z-index:5;top:100%;left:0;right:0;display:none;margin-top:7px;max-height:340px;overflow:auto;background:#171915;border:1px solid #383a34;border-radius:10px;box-shadow:0 15px 35px #000b}.search-results.show{display:block}.search-result{display:block;width:100%;padding:12px 14px;text-align:left;border:0;border-bottom:1px solid #30322d;background:transparent;cursor:pointer}.search-result:last-child{border-bottom:0}.search-result:hover,.search-result:focus{background:#23271f;outline:none}.result-title{font:16px var(--serif);color:#f2f1eb}.result-meta{display:block;margin-top:4px;font-size:11px;color:#aaa99f;line-height:1.45}.result-meta mark{color:#c9e4aa;background:transparent}.empty-result{padding:14px;color:#aaa99f;font-size:12px;line-height:1.5}@media(max-width:720px){.hero{display:block}.searchbox{width:100%;margin-top:28px}.search-results{max-height:250px}}
  </style>
<style>
    .ask-button{flex:0 0 31px;height:31px;border:0;border-radius:7px;background:var(--green);color:#10130e;font-size:19px;font-weight:700;cursor:pointer}.ask-button:hover{filter:brightness(1.12)}.assistant-caption{margin-top:8px;color:#85867e;font-size:10px}.search-results{max-height:390px}.assistant-message{padding:12px 14px;border-bottom:1px solid #30322d}.assistant-question{font-size:12px;font-weight:650;color:#d9edc4;margin-bottom:8px}.assistant-answer{font-size:12px;line-height:1.55;color:#d0d0c8}.assistant-source{margin-top:10px;padding-top:9px;border-top:1px solid #30322d}.assistant-source button{padding:0;border:0;background:none;color:#b9d99f;text-align:left;font:11px var(--sans);cursor:pointer}.assistant-source button:hover{text-decoration:underline}.assistant-empty{color:#aaa99f;font-size:12px;line-height:1.55}@media(max-width:720px){.search-results{max-height:250px}}

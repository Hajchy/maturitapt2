    function buildTopicQuoteSets(topicIndex){const bank=notes[topicIndex].blocks.flatMap(block=>block.text.split(/\n+/u).flatMap(line=>{const cleaned=line.trim().replace(/^(?:[•–-]|\d+[.)])\s*/u,'');if(!cleaned)return[];return cleaned.split(/(?<=[.!?])\s+(?=[A-ZÁČĎÉĚÍŇÓŘŠŤÚŮÝŽ0-9])/u).map(sentence=>sentence.trim()).filter(sentence=>sentence.length>35)}));const unique=[...new Set(bank)];return[0,1,2].map(group=>unique.filter((_,index)=>index%3===group).slice(0,10))}
    const exactSummarySets={0:buildTopicQuoteSets(0),2:vrtakyQuoteSets,3:buildTopicQuoteSets(3),13:buildTopicQuoteSets(13)};
    const exactSummaryCursor={};
    const summaryLastSelection={};
    function pickRandomSummary(i){const sets=exactSummarySets[i];if(sets&&sets.length){const next=((exactSummaryCursor[i]??-1)+1)%sets.length;exactSummaryCursor[i]=next;return sets[next]}const base=topicSummaries[i],alternatives=topicSummaryAlternatives[i]||[];if(!base)return null;const versions=[base,...alternatives];let choices=versions.map((items,index)=>({items,index})).filter(option=>option.index!==summaryLastSelection[i]);if(!choices.length)choices=versions.map((items,index)=>({items,index}));const chosen=choices[Math.floor(Math.random()*choices.length)];summaryLastSelection[i]=chosen.index;return chosen.items}
    const grid=document.getElementById('grid'),overlay=document.getElementById('overlay'),detail=document.getElementById('detail'),questionSearchBox=document.querySelector('.question-search'),imageViewer=document.getElementById('imageViewer'),imageViewerImage=document.getElementById('imageViewerImage'),imageViewerCaption=document.getElementById('imageViewerCaption');let active=0,lastFocus=null,imageViewerReturnFocus=null;
    function openImageViewer(item,trigger){imageViewerReturnFocus=trigger;imageViewerImage.src=item.src;imageViewerImage.alt=item.alt;imageViewerCaption.textContent=item.caption;imageViewer.classList.add('open');imageViewer.setAttribute('aria-hidden','false');document.getElementById('imageViewerClose').focus()}
    function closeImageViewer(){imageViewer.classList.remove('open');imageViewer.setAttribute('aria-hidden','true');imageViewerImage.removeAttribute('src');if(imageViewerReturnFocus&&imageViewerReturnFocus.isConnected)imageViewerReturnFocus.focus()}
    document.getElementById('imageViewerClose').addEventListener('click',closeImageViewer);imageViewer.addEventListener('click',e=>{if(e.target===imageViewer)closeImageViewer()});    function renderGrid(){grid.innerHTML='';notes.forEach((n,i)=>{const item=document.createElement('div');item.className='topic-card-item';const card=document.createElement('button');card.className='card';card.type='button';card.innerHTML=`<span class="card-top"><span class="number">${String(i+1).padStart(2,'0')}</span><span class="status"></span></span><div class="card-title-group"><h2></h2><span class="card-author"></span></div><span class="card-foot"><span class="arrow">↗</span></span>`;card.querySelector('.status').textContent='';card.querySelector('h2').textContent=n.title;const author=topicAuthors[i+1]||'';card.querySelector('.card-author').textContent=author;card.querySelector('.card-author').hidden=!author;card.setAttribute('aria-label',`${n.title}${author?`, autor ${author}`:''}`);card.addEventListener('click',()=>openQuestionModal(i,card));const summaryButton=document.createElement('button');summaryButton.type='button';summaryButton.className='card-summary-open';summaryButton.textContent='Shrnutí';summaryButton.setAttribute('aria-label',`Otevřít shrnutí: ${n.title}`);summaryButton.addEventListener('click',()=>openSummaryModal(i,summaryButton));item.append(card,summaryButton);grid.appendChild(item)})}    function buildStudyEstimate(n){
      const words=n.blocks.reduce((sum,block)=>sum+(block.text.trim()?block.title.trim().split(/\s+/u).length+block.text.trim().split(/\s+/u).length:0),0);
      const target=1500,percent=Math.min(100,Math.round(words/target*100));
      const panel=document.createElement('aside');panel.className='study-estimate';panel.dataset.searchExclude='true';
      panel.innerHTML=`<div class="study-estimate-top"><strong>Počet slov</strong></div><div class="study-estimate-track" role="progressbar" aria-label="Rozsah zápisků vůči cíli 1500 slov" aria-valuemin="0" aria-valuemax="${target}" aria-valuenow="${Math.min(words,target)}"><span style="width:${percent}%"></span></div><div class="study-estimate-count">${words.toLocaleString('cs-CZ')} / ${target.toLocaleString('cs-CZ')} slov</div>`;
      return panel;
    }
    function setMathText(element,text){
      element.textContent='';
      const pattern=/(?<![\p{L}\d])(\([^()\n]+\)|\d+(?:[.,]\d+)?(?:\s*[×x]\s*[\p{L}\dπ⁻¹.,]+)*)\s*\/\s*(\([^()\n]+\)|3,14\s*[×x]\s*D|π\s*[×x]\s*D|\d+(?:[.,]\d+)?|D)(?![\p{L}\d])/gu;
      let last=0,match;
      while((match=pattern.exec(text))!==null){
        element.append(document.createTextNode(text.slice(last,match.index)));
        const fraction=document.createElement('span');fraction.className='math-fraction';fraction.setAttribute('role','img');fraction.setAttribute('aria-label',match[1]+' děleno '+match[2]);
        const numerator=document.createElement('span');numerator.textContent=match[1].replace(/^\(|\)$/g,'');
        const denominator=document.createElement('span');denominator.textContent=match[2].replace(/^\(|\)$/g,'');
        fraction.append(numerator,denominator);element.append(fraction);last=pattern.lastIndex;
      }
      element.append(document.createTextNode(text.slice(last)));
    }

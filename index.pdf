<style>
    .detail-title-row{display:flex;align-items:flex-start;gap:24px}.detail-title-row h2{flex:1;min-width:0;margin:14px 0}.detail-title-row .question-search{flex:0 1 390px;width:min(390px,52%);margin:18px 0 0}
    @media(max-width:720px){.detail-title-row{gap:10px;flex-wrap:wrap}.detail-title-row h2{flex:1 1 100%;margin:12px 0 2px}.detail-title-row .question-search{flex:1 1 100%;width:100%;margin:0}}

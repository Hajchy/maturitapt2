    @media(max-width:720px){.hero{padding-bottom:195px}}
</style><style>
    .search-highlight{color:#10130e;background:#b9db91;border-radius:3px;padding:0 2px;box-shadow:0 0 0 2px #b9db9140}
</style><style>
    .search-results.search-history-list{background:#171915;border:1px solid #383a34;border-radius:10px;box-shadow:0 15px 35px #000b;padding:7px;overflow:hidden}
    .search-history-title{padding:6px 9px 7px;color:#aaa99f;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
    .search-history-item{display:block;width:100%;padding:9px;text-align:left;color:#e5e6df;background:transparent;border:0;border-top:1px solid #30322d;font:13px var(--sans);cursor:pointer}
    .search-history-item:hover,.search-history-item:focus{background:#23271f;outline:none}
</style><style>
    .detail{max-width:none;width:100%}.detail-lead{max-width:none}
</style><style>
    .study-text{font-size:16px;line-height:1.8;color:#e0e0d8}.detail-lead{color:#d0cfc7}
</style><style>
    .study-figures{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}
    .study-figure{min-width:0;margin:0;padding:9px;background:#111310;border:1px solid #30322d;border-radius:9px}
    .study-figure img{display:block;width:100%;height:190px;object-fit:contain;border-radius:5px}
    .study-figure.focus-figure img{height:420px}
    .study-figure.wide,.study-figures .study-figure:only-child{grid-column:1/-1}
    .study-image-open{display:block;width:100%;padding:0;border:0;background:transparent;border-radius:5px;cursor:url("data:image/svg+xml;base64,") 16 16, zoom-in}
    .study-image-open:focus-visible{outline:2px solid var(--green);outline-offset:3px}
    .study-figure figcaption{margin-top:7px;color:#aaa99f;font-size:11px;line-height:1.4}
    .question-search{display:flex;align-items:center;gap:7px;width:min(390px,48%);margin:0 auto;padding:4px 6px 4px 12px;background:#171915;border:1px solid #383a34;border-radius:8px}
    .question-search:focus-within{border-color:#829c6e}.question-search input{min-width:0;flex:1;height:31px;border:0;outline:0;background:transparent;color:var(--ink);font:13px var(--sans)}
    .question-search input::placeholder{color:#85867e}.question-search button{flex:0 0 29px;height:29px;border:0;border-radius:6px;background:var(--green);color:#10130e;font-size:19px;cursor:pointer}
    .question-search #questionSearchCount[hidden]{display:none!important}.question-search #questionSearchCount{white-space:nowrap;color:#b9d99f;font-size:10px}.question-search-hit{color:#10130e;background:#b9db91;border-radius:2px;padding:0 1px}.question-search-hit:first-of-type{box-shadow:0 0 0 2px #b9db9170}
    @media(max-width:720px){.study-figures{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.study-figure img{height:135px}.study-figure.focus-figure img{height:300px}.question-search{width:auto;flex:1;margin:0 8px}.modal-mark{font-size:10px;gap:6px}.question-search input{font-size:11px}.question-search #questionSearchCount{display:none}}
    @media(max-width:430px){.study-figures{grid-template-columns:1fr}.study-figure.focus-figure img{height:240px}.question-search{padding-left:7px}.question-search input::placeholder{font-size:10px}}
